{
  "templateId": "patiserie",
  "version": 1,
  "name": "Patiserie & Cofetărie",
  "language": "ro",
  "wizardHints": {
    "vertical": "food",
    "aiStyle": "cald, artizanal, afectuos — tonul unei cofetărești de familie care pune suflet în fiecare produs"
  },
  "sections": [
    {
      "id": "business",
      "title": "Despre afacere",
      "fields": [
        {
          "key": "business.name",
          "type": "text",
          "label": "Numele cofetăriei / patiseriei",
          "required": true,
          "maxLen": 60
        },
        {
          "key": "business.tagline",
          "type": "text",
          "label": "Slogan scurt (ex: Torturi artizanale, prăjituri de casă)",
          "required": true,
          "maxLen": 100
        },
        {
          "key": "business.title",
          "type": "text",
          "label": "Titlul paginii (pentru browser și Google)",
          "required": true,
          "maxLen": 80
        },
        {
          "key": "business.metaDescription",
          "type": "textarea",
          "label": "Descriere SEO (1–2 propoziții despre ce oferiți și unde vă aflați)",
          "required": true,
          "maxLen": 160
        },
        {
          "key": "business.about",
          "type": "textarea",
          "label": "Textul secțiunii «Despre noi» (povestea cofetăriei)",
          "required": true,
          "maxLen": 600
        },
        {
          "key": "business.lang",
          "type": "text",
          "label": "Codul limbii paginii (ro / en)",
          "required": true,
          "maxLen": 5
        }
      ]
    },
    {
      "id": "labels",
      "title": "Etichete interfață",
      "fields": [
        {
          "key": "labels.about",
          "type": "text",
          "label": "Titlul secțiunii «Despre noi»",
          "required": true,
          "maxLen": 40
        },
        {
          "key": "labels.instaTitle",
          "type": "text",
          "label": "Titlul secțiunii Instagram",
          "required": true,
          "maxLen": 60
        },
        {
          "key": "labels.instaFollow",
          "type": "text",
          "label": "Textul butonului de follow",
          "required": true,
          "maxLen": 20
        },
        {
          "key": "labels.scroll",
          "type": "text",
          "label": "Textul indicatorului de scroll de pe hero",
          "required": true,
          "maxLen": 20
        },
        {
          "key": "labels.waQr",
          "type": "text",
          "label": "Titlul modalului QR WhatsApp",
          "required": true,
          "maxLen": 60
        },
        {
          "key": "labels.waOpen",
          "type": "text",
          "label": "Textul linkului «Deschide WhatsApp Web»",
          "required": true,
          "maxLen": 60
        }
      ]
    },
    {
      "id": "theme",
      "title": "Culori & aspect",
      "fields": [
        {
          "key": "theme.primary",
          "type": "color",
          "label": "Culoarea principală a brandului (ex: #E8588C)",
          "required": true
        },
        {
          "key": "theme.primaryLight",
          "type": "color",
          "label": "Varianta deschisă a culorii principale",
          "required": true
        },
        {
          "key": "theme.primaryDark",
          "type": "color",
          "label": "Varianta închisă a culorii principale",
          "required": true
        },
        {
          "key": "theme.cream",
          "type": "color",
          "label": "Culoarea de fond a paginii (culoare crem / neutru)",
          "required": true
        }
      ]
    },
    {
      "id": "hero",
      "title": "Secțiunea hero (prima vedere)",
      "fields": [
        {
          "key": "logo",
          "type": "text",
          "label": "Calea imaginii logo (ex: images/logo.jpg) sau lasă gol dacă nu ai logo",
          "required": false,
          "maxLen": 200
        },
        {
          "key": "showWordmark",
          "type": "text",
          "label": "Afișează numele ca text pe hero dacă nu există logo? (true / false)",
          "required": false
        },
        {
          "key": "hero.background",
          "type": "text",
          "label": "Fundalul heroului — url('images/hero.jpg') sau gradient CSS",
          "required": true,
          "maxLen": 300
        },
        {
          "key": "hero.ctaLabel",
          "type": "text",
          "label": "Textul butonului principal de pe hero (ex: Comandă acum)",
          "required": true,
          "maxLen": 40
        }
      ]
    },
    {
      "id": "services",
      "title": "Specialități / Produse",
      "fields": [
        {
          "key": "servicesTitle",
          "type": "text",
          "label": "Titlul secțiunii de specialități (ex: Specialitățile noastre)",
          "required": false,
          "maxLen": 60
        },
        {
          "key": "services",
          "type": "list",
          "label": "Lista de produse / servicii (emoji + denumire)",
          "required": false,
          "min": 0,
          "max": 12,
          "itemShape": {
            "icon": "text",
            "label": "text"
          }
        }
      ]
    },
    {
      "id": "gallery",
      "title": "Galerie foto",
      "fields": [
        {
          "key": "galleryTitle",
          "type": "text",
          "label": "Titlul secțiunii galerie (ex: Creațiile noastre) sau lasă gol",
          "required": false,
          "maxLen": 60
        },
        {
          "key": "categories",
          "type": "list",
          "label": "Categorii de poze (titlu opțional + set de imagini)",
          "required": true,
          "min": 1,
          "max": 6,
          "itemShape": {
            "title": "text",
            "blurb": "text",
            "photos": "photos"
          }
        }
      ]
    },
    {
      "id": "instagram",
      "title": "Instagram",
      "fields": [
        {
          "key": "instagram.handle",
          "type": "text",
          "label": "Username Instagram (fără @)",
          "required": false,
          "maxLen": 60
        },
        {
          "key": "instagram.url",
          "type": "url",
          "label": "Link complet Instagram (https://www.instagram.com/...)",
          "required": false
        }
      ]
    },
    {
      "id": "contact",
      "title": "Contact & comandă",
      "fields": [
        {
          "key": "contact.title",
          "type": "text",
          "label": "Titlul cardului de contact (ex: Comandă acum)",
          "required": true,
          "maxLen": 50
        },
        {
          "key": "contact.intro",
          "type": "textarea",
          "label": "Textul introductiv al cardului de contact",
          "required": true,
          "maxLen": 200
        },
        {
          "key": "contact.whatsapp",
          "type": "phone",
          "label": "Număr WhatsApp (format internațional fără +, ex: 40721000000)",
          "required": false
        },
        {
          "key": "contact.waHref",
          "type": "url",
          "label": "Link WhatsApp complet cu mesaj precompletat (https://wa.me/...)",
          "required": false
        },
        {
          "key": "contact.phone",
          "type": "phone",
          "label": "Număr de telefon (cu prefix, ex: +40721000000)",
          "required": false
        },
        {
          "key": "contact.phoneDisplay",
          "type": "text",
          "label": "Numărul de telefon afișat (ex: +40 721 000 000)",
          "required": false,
          "maxLen": 30
        },
        {
          "key": "contact.instagram.url",
          "type": "url",
          "label": "Link Instagram pentru secțiunea contact",
          "required": false
        },
        {
          "key": "contact.instagram.label",
          "type": "text",
          "label": "Textul linkului Instagram în contact (ex: @cofetaria_ta)",
          "required": false,
          "maxLen": 60
        },
        {
          "key": "contact.facebook.url",
          "type": "url",
          "label": "Link Facebook (opțional)",
          "required": false
        },
        {
          "key": "contact.facebook.label",
          "type": "text",
          "label": "Textul linkului Facebook (ex: Cofetăria Noastră)",
          "required": false,
          "maxLen": 60
        },
        {
          "key": "contact.address",
          "type": "textarea",
          "label": "Adresa fizică afișată (poți folosi <br> pentru rânduri noi — valoare pre-escapată)",
          "required": false,
          "maxLen": 200
        },
        {
          "key": "contact.addressHref",
          "type": "url",
          "label": "Link Google Maps pentru adresă",
          "required": false
        }
      ]
    },
    {
      "id": "seo",
      "title": "SEO & partajare socială",
      "fields": [
        {
          "key": "seo.ogImage",
          "type": "url",
          "label": "URL imagine pentru partajare pe social media (og:image)",
          "required": false
        },
        {
          "key": "seo.jsonLd",
          "type": "textarea",
          "label": "JSON-LD Schema.org (opțional — generat automat de bot)",
          "required": false
        }
      ]
    },
    {
      "id": "footer",
      "title": "Footer",
      "fields": [
        {
          "key": "footer.address",
          "type": "text",
          "label": "Adresa scurtă din footer",
          "required": true,
          "maxLen": 120
        },
        {
          "key": "footer.year",
          "type": "text",
          "label": "Anul pentru copyright (ex: 2026)",
          "required": true,
          "maxLen": 4
        },
        {
          "key": "footer.note",
          "type": "text",
          "label": "Notița mică din footer (ex: Cu drag, în fiecare zi.)",
          "required": false,
          "maxLen": 100
        }
      ]
    }
  ]
}
