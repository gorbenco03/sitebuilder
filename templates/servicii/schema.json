{
  "templateId": "servicii-locale",
  "version": 2,
  "name": "Servicii Locale",
  "language": "ro",
  "wizardHints": {
    "vertical": "Servicii locale — curățenie, reparații, instalații, transport/mutări, îngrijire",
    "aiStyle": "Ton prietenos și direct; evidențiază seriozitatea, promptitudinea și garanția; evită superlativele vide; folosește verbe de acțiune; sublinează beneficii concrete (timp răspuns, garanție, asigurare)"
  },
  "sections": [
    {
      "id": "business",
      "title": "Despre afacere",
      "fields": [
        {
          "key": "business.name",
          "type": "text",
          "label": "Numele afacerii",
          "required": true,
          "maxLen": 60
        },
        {
          "key": "business.tagline",
          "type": "text",
          "label": "Slogan scurt (max 80 caractere)",
          "required": true,
          "maxLen": 80
        },
        {
          "key": "business.title",
          "type": "text",
          "label": "Titlu pagină SEO (apare în tab browser, max 70 car.)",
          "required": true,
          "maxLen": 70
        },
        {
          "key": "business.metaDescription",
          "type": "textarea",
          "label": "Descriere SEO (max 160 caractere)",
          "required": true,
          "maxLen": 160
        },
        {
          "key": "business.about",
          "type": "textarea",
          "label": "Paragraf de prezentare — experiență, zona acoperită, ce vă diferențiază",
          "required": true,
          "maxLen": 700
        },
        {
          "key": "business.lang",
          "type": "text",
          "label": "Codul limbii (ex: ro, en)",
          "required": false,
          "maxLen": 5,
          "default": "ro"
        }
      ]
    },
    {
      "id": "theme",
      "title": "Culori brand",
      "fields": [
        {
          "key": "theme.primary",
          "type": "color",
          "label": "Culoare principală (hex) — teal/verde sau albastru calm recomandat",
          "required": true
        },
        {
          "key": "theme.primaryLight",
          "type": "color",
          "label": "Culoare deschisă (hover/accent)",
          "required": true
        },
        {
          "key": "theme.primaryDark",
          "type": "color",
          "label": "Culoare închisă (titluri/CTA)",
          "required": true
        },
        {
          "key": "theme.cream",
          "type": "color",
          "label": "Fundal pagină (cream/alb cald recomandat)",
          "required": true
        }
      ]
    },
    {
      "id": "hero",
      "title": "Secțiunea Hero (prima pagină)",
      "fields": [
        {
          "key": "logo",
          "type": "text",
          "label": "Cale logo (images/logo.png) sau gol dacă nu există",
          "required": false
        },
        {
          "key": "showWordmark",
          "type": "text",
          "label": "Afișează numele ca text mare dacă nu există logo — scrie true sau false",
          "required": false,
          "default": "true",
          "note": "Valorile acceptate: true | false. Motorul de build tratează șirul 'false' ca valoare falsă (ascunde wordmark-ul)."
        },
        {
          "key": "hero.background",
          "type": "text",
          "label": "Fundal hero — gradient CSS sau url('images/hero.jpg')",
          "required": true
        },
        {
          "key": "hero.ctaLabel",
          "type": "text",
          "label": "Text buton principal (ex: Solicită ofertă gratuită)",
          "required": true,
          "maxLen": 50
        },
        {
          "key": "heroBenefits",
          "type": "list",
          "label": "3 beneficii cheie afișate în hero (text simplu, fiecare max 40 car.)",
          "required": false,
          "itemShape": "text",
          "maxItems": 3
        }
      ]
    },
    {
      "id": "services",
      "title": "Servicii oferite",
      "fields": [
        {
          "key": "servicesTitle",
          "type": "text",
          "label": "Titlu secțiune servicii (ex: Ce facem, Ce curățăm)",
          "required": false,
          "maxLen": 60
        },
        {
          "key": "services",
          "type": "list",
          "label": "Lista serviciilor — SVG path elements + denumire (fără tag <svg>)",
          "required": false,
          "itemShape": { "icon": "text", "label": "text" },
          "note": "Câmpul icon conține elementele SVG interioare (ex: <path d='...'/>). Se randează în interiorul unui <svg viewBox='0 0 24 24'>."
        }
      ]
    },
    {
      "id": "steps",
      "title": "Cum lucrăm (3 pași)",
      "fields": [
        {
          "key": "steps",
          "type": "list",
          "label": "Pașii procesului (opțional — lăsați gol pentru a ascunde secțiunea)",
          "required": false,
          "itemShape": { "title": "text", "text": "text" },
          "maxItems": 4
        }
      ]
    },
    {
      "id": "zone_schedule",
      "title": "Zonă de acoperire și program",
      "fields": [
        {
          "key": "zone",
          "type": "text",
          "label": "Zona acoperită (ex: București — toate sectoarele + Ilfov)",
          "required": false,
          "maxLen": 140
        },
        {
          "key": "schedule",
          "type": "text",
          "label": "Program (ex: Luni–Sâmbătă 08:00–20:00)",
          "required": false,
          "maxLen": 100
        }
      ]
    },
    {
      "id": "gallery",
      "title": "Galerie foto (lucrări/rezultate)",
      "fields": [
        {
          "key": "galleryTitle",
          "type": "text",
          "label": "Titlu galerie (opțional)",
          "required": false,
          "maxLen": 60
        },
        {
          "key": "categories",
          "type": "list",
          "label": "Categorii foto — titlu, descriere scurtă, poze",
          "required": false,
          "itemShape": { "title": "text", "blurb": "text", "photos": "photos" }
        }
      ]
    },
    {
      "id": "reviews",
      "title": "Recenzii clienți",
      "fields": [
        {
          "key": "reviews",
          "type": "list",
          "label": "Testimoniale clienți (opțional — lăsați gol pentru a ascunde)",
          "required": false,
          "itemShape": { "name": "text", "text": "text" },
          "maxItems": 6
        }
      ]
    },
    {
      "id": "instagram",
      "title": "Instagram",
      "fields": [
        {
          "key": "instagram.handle",
          "type": "text",
          "label": "Cont Instagram fără @ (ex: firma_ta)",
          "required": false
        },
        {
          "key": "instagram.url",
          "type": "url",
          "label": "Link Instagram complet",
          "required": false
        },
        {
          "key": "instagram.gallery",
          "type": "photos",
          "label": "Poze grilă Instagram (opțional, max 6 imagini pătrate)",
          "required": false
        }
      ]
    },
    {
      "id": "contact",
      "title": "Date de contact",
      "fields": [
        {
          "key": "contact.title",
          "type": "text",
          "label": "Titlu card contact (ex: Solicită ofertă gratuită)",
          "required": true,
          "maxLen": 55
        },
        {
          "key": "contact.intro",
          "type": "textarea",
          "label": "Text intro contact — ce se întâmplă după ce te contactează",
          "required": true,
          "maxLen": 220
        },
        {
          "key": "contact.phone",
          "type": "phone",
          "label": "Număr telefon (format internațional, ex: +40721000000)",
          "required": false
        },
        {
          "key": "contact.phoneDisplay",
          "type": "text",
          "label": "Număr telefon afișat (ex: +40 721 000 000)",
          "required": false
        },
        {
          "key": "contact.whatsapp",
          "type": "phone",
          "label": "Număr WhatsApp (cifre fără +, ex: 40721000000)",
          "required": false
        },
        {
          "key": "contact.waHref",
          "type": "url",
          "label": "Link WhatsApp cu mesaj pre-completat (wa.me/...)",
          "required": false
        },
        {
          "key": "contact.instagram.url",
          "type": "url",
          "label": "Link Instagram (sau gol)",
          "required": false
        },
        {
          "key": "contact.instagram.label",
          "type": "text",
          "label": "Eticheta Instagram (ex: @firma_ta)",
          "required": false
        },
        {
          "key": "contact.facebook.url",
          "type": "url",
          "label": "Link Facebook (sau gol)",
          "required": false
        },
        {
          "key": "contact.facebook.label",
          "type": "text",
          "label": "Eticheta Facebook",
          "required": false
        },
        {
          "key": "contact.address",
          "type": "textarea",
          "label": "Adresă fizică (HTML simplu permis: <br>)",
          "required": false
        },
        {
          "key": "contact.addressHref",
          "type": "url",
          "label": "Link Google Maps (sau gol pentru adresă fără link)",
          "required": false
        }
      ]
    },
    {
      "id": "seo_footer",
      "title": "SEO și footer",
      "fields": [
        {
          "key": "seo.ogImage",
          "type": "url",
          "label": "URL imagine OG pentru social sharing (1200×630px recomandat)",
          "required": false
        },
        {
          "key": "seo.jsonLd",
          "type": "textarea",
          "label": "JSON-LD Schema.org (opțional — LocalBusiness, HomeAndConstruction, etc.)",
          "required": false
        },
        {
          "key": "seo.canonical",
          "type": "url",
          "label": "URL canonic al site-ului (opțional)",
          "required": false
        },
        {
          "key": "footer.address",
          "type": "text",
          "label": "Adresă/Zonă în footer (text simplu)",
          "required": false
        },
        {
          "key": "footer.year",
          "type": "text",
          "label": "Anul copyright",
          "required": false,
          "default": "2026"
        },
        {
          "key": "footer.note",
          "type": "text",
          "label": "Notă footer (ex: Servicii de calitate cu garanție.)",
          "required": false
        }
      ]
    },
    {
      "id": "labels",
      "title": "Etichete interfață",
      "fields": [
        {
          "key": "labels.about",
          "type": "text",
          "label": "Eticheta secțiunii Despre (ex: Despre noi)",
          "required": false,
          "default": "Despre noi"
        },
        {
          "key": "labels.instaTitle",
          "type": "text",
          "label": "Titlu secțiune Instagram",
          "required": false,
          "default": "Urmărește-ne pe Instagram"
        },
        {
          "key": "labels.instaFollow",
          "type": "text",
          "label": "Text buton urmărire Instagram",
          "required": false,
          "default": "Urmărește"
        },
        {
          "key": "labels.scroll",
          "type": "text",
          "label": "Text indicator scroll (ex: Derulează)",
          "required": false,
          "default": "Derulează"
        },
        {
          "key": "labels.waQr",
          "type": "text",
          "label": "Titlu modal QR WhatsApp",
          "required": false,
          "default": "Deschide WhatsApp pe telefon"
        },
        {
          "key": "labels.waOpen",
          "type": "text",
          "label": "Text link WhatsApp Web în modal",
          "required": false,
          "default": "Sau deschide WhatsApp Web"
        }
      ]
    }
  ]
}
