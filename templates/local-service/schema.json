{
  "templateId": "local-service",
  "version": 1,
  "name": "Trades",
  "language": "en",
  "wizardHints": {
    "vertical": "local-service",
    "aiStyle": "direct, trustworthy, industrial-clean — condensed sans on headings, high anthracite/amber contrast, visible phone CTA; tone of a serious local company"
  },
  "sections": [
    {
      "id": "business",
      "title": "Company info",
      "fields": [
        {
          "key": "business.name",
          "type": "text",
          "label": "Business or trade name",
          "required": true,
          "maxLen": 60
        },
        {
          "key": "business.tagline",
          "type": "text",
          "label": "Short tagline (e.g. Quality interior renovations)",
          "required": true,
          "maxLen": 80
        },
        {
          "key": "business.title",
          "type": "text",
          "label": "Titlu pagină pentru browser (bara de sus)",
          "required": true,
          "maxLen": 70
        },
        {
          "key": "business.metaDescription",
          "type": "textarea",
          "label": "Short description for Google (160 characters max)",
          "required": true,
          "maxLen": 160
        },
        {
          "key": "business.about",
          "type": "textarea",
          "label": "About your business (2–4 sentences on what you do)",
          "required": true,
          "maxLen": 500
        },
        {
          "key": "business.lang",
          "type": "text",
          "label": "Site language",
          "required": true,
          "maxLen": 10
        },
        {
          "key": "business.yearsExp",
          "type": "text",
          "label": "Years of experience (e.g. 12)",
          "required": false,
          "maxLen": 4
        },
        {
          "key": "business.projectsDone",
          "type": "text",
          "label": "Proiecte finalizate (ex. 240) — pe deschidere și la statistici",
          "required": false,
          "maxLen": 10
        },
        {
          "key": "business.zone",
          "type": "text",
          "label": "Service area (e.g. Austin and the surrounding area)",
          "required": false,
          "maxLen": 100
        }
      ]
    },
    {
      "id": "labels",
      "title": "Button and section text",
      "fields": [
        {
          "key": "labels.about",
          "type": "text",
          "label": "About section title (e.g. About us)",
          "required": true,
          "maxLen": 40
        },
        {
          "key": "labels.instaTitle",
          "type": "text",
          "label": "Instagram section title (e.g. Follow us on Instagram)",
          "required": true,
          "maxLen": 60
        },
        {
          "key": "labels.instaFollow",
          "type": "text",
          "label": "Instagram follow button text (e.g. Follow)",
          "required": true,
          "maxLen": 30
        },
        {
          "key": "labels.scroll",
          "type": "text",
          "label": "Scroll indicator text (e.g. Scroll)",
          "required": true,
          "maxLen": 30
        },
        {
          "key": "labels.waQr",
          "type": "text",
          "label": "WhatsApp QR modal title (e.g. Open WhatsApp on your phone)",
          "required": true,
          "maxLen": 60
        },
        {
          "key": "labels.waOpen",
          "type": "text",
          "label": "Secondary WhatsApp Web button (e.g. Or open WhatsApp Web)",
          "required": true,
          "maxLen": 60
        },
        {
          "key": "labels.whatsapp",
          "type": "text",
          "label": "WhatsApp link label (contact section)",
          "required": false,
          "maxLen": 24
        },
        {
          "key": "labels.close",
          "type": "text",
          "label": "Close button label (accessibility)",
          "required": false,
          "maxLen": 24
        },
        {
          "key": "labels.callCta",
          "type": "text",
          "label": "Call button / sticky dock CTA (e.g. Call / Sună)",
          "required": false,
          "maxLen": 24
        },
        {
          "key": "labels.yearsExperience",
          "type": "text",
          "label": "Etichetă contor sub ani (ex. ani experiență)",
          "required": false,
          "maxLen": 40
        },
        {
          "key": "labels.projects",
          "type": "text",
          "label": "Etichetă contor sub numărul de proiecte (ex. proiecte)",
          "required": false,
          "maxLen": 40
        },
        {
          "key": "labels.yearsOnJob",
          "type": "text",
          "label": "About badge suffix (e.g. years on the job)",
          "required": false,
          "maxLen": 40
        },
        {
          "key": "labels.servicesEyebrow",
          "type": "text",
          "label": "Services section eyebrow (e.g. Specifications)",
          "required": false,
          "maxLen": 40
        },
        {
          "key": "labels.processEyebrow",
          "type": "text",
          "label": "Process section eyebrow (e.g. Process)",
          "required": false,
          "maxLen": 40
        },
        {
          "key": "labels.processTitle",
          "type": "text",
          "label": "Process section title (e.g. How we work)",
          "required": false,
          "maxLen": 60
        },
        {
          "key": "labels.defaultStep1Title",
          "type": "text",
          "label": "Default process step 1 title (when no custom steps)",
          "required": false,
          "maxLen": 60
        },
        {
          "key": "labels.defaultStep1Text",
          "type": "text",
          "label": "Default process step 1 body",
          "required": false,
          "maxLen": 200
        },
        {
          "key": "labels.defaultStep2Title",
          "type": "text",
          "label": "Default process step 2 title",
          "required": false,
          "maxLen": 60
        },
        {
          "key": "labels.defaultStep2Text",
          "type": "text",
          "label": "Default process step 2 body",
          "required": false,
          "maxLen": 200
        },
        {
          "key": "labels.defaultStep3Title",
          "type": "text",
          "label": "Default process step 3 title",
          "required": false,
          "maxLen": 60
        },
        {
          "key": "labels.defaultStep3Text",
          "type": "text",
          "label": "Default process step 3 body",
          "required": false,
          "maxLen": 200
        },
        {
          "key": "labels.trustEyebrow",
          "type": "text",
          "label": "Trust section eyebrow (e.g. Commitment)",
          "required": false,
          "maxLen": 40
        },
        {
          "key": "labels.trustTitle",
          "type": "text",
          "label": "Trust section title (e.g. Why choose us)",
          "required": false,
          "maxLen": 60
        },
        {
          "key": "labels.contactBandTitle",
          "type": "text",
          "label": "Bottom contact band title (e.g. Ready to get started?)",
          "required": false,
          "maxLen": 80
        },
        {
          "key": "labels.contactBandText",
          "type": "text",
          "label": "Bottom contact band body text",
          "required": false,
          "maxLen": 160
        },
        {
          "key": "labels.contactBandAria",
          "type": "text",
          "label": "Contact band aria-label",
          "required": false,
          "maxLen": 40
        },
        {
          "key": "labels.dockAria",
          "type": "text",
          "label": "Sticky phone dock region aria-label",
          "required": false,
          "maxLen": 40
        },
        {
          "key": "labels.galleryEyebrow",
          "type": "text",
          "label": "Gallery section eyebrow (e.g. Work)",
          "required": false,
          "maxLen": 40
        },
        {
          "key": "labels.lightboxPreview",
          "type": "text",
          "label": "Lightbox dialog aria-label (e.g. Photo preview)",
          "required": false,
          "maxLen": 40
        },
        {
          "key": "labels.lightboxPrev",
          "type": "text",
          "label": "Lightbox previous button aria-label",
          "required": false,
          "maxLen": 24
        },
        {
          "key": "labels.lightboxNext",
          "type": "text",
          "label": "Lightbox next button aria-label",
          "required": false,
          "maxLen": 24
        }
      ]
    },
    {
      "id": "visual",
      "title": "Appearance",
      "fields": [
        {
          "key": "theme.primary",
          "type": "color",
          "label": "Primary accent color (site-yellow recommended: #F5A623)",
          "required": true
        },
        {
          "key": "theme.primaryLight",
          "type": "color",
          "label": "Lighter accent shade",
          "required": true
        },
        {
          "key": "theme.primaryDark",
          "type": "color",
          "label": "Darker accent shade",
          "required": true
        },
        {
          "key": "theme.cream",
          "type": "color",
          "label": "Page background color (light gray recommended: #F4F5F7)",
          "required": true
        },
        {
          "key": "logo",
          "type": "text",
          "label": "Logo path (e.g. images/logo.png) — leave blank if you don't have one",
          "required": false
        },
        {
          "key": "showWordmark",
          "type": "text",
          "label": "Show the business name as text? (true/false, if you don't have a logo)",
          "required": false
        }
      ]
    },
    {
      "id": "hero",
      "title": "Prima impresie",
      "fields": [
        {
          "key": "hero.background",
          "type": "background",
          "label": "Fundal deschidere",
          "hint": "Pick a color and optional photo. The live preview updates immediately.",
          "required": true
        },
        {
          "key": "hero.ctaLabel",
          "type": "text",
          "label": "Main button text (e.g. Get a free quote)",
          "required": true,
          "maxLen": 40
        }
      ]
    },
    {
      "id": "services",
      "title": "Services offered",
      "fields": [
        {
          "key": "servicesTitle",
          "type": "text",
          "label": "Services section title (e.g. Our services)",
          "required": false,
          "maxLen": 60
        },
        {
          "key": "services",
          "type": "list",
          "label": "Services list (emoji icon + name)",
          "required": false,
          "min": 0,
          "max": 12,
          "itemShape": {
            "icon": "text",
            "label": "text"
          }
        }
      ]
    },
    {
      "id": "trust",
      "title": "Why us (trust points)",
      "fields": [
        {
          "key": "trust",
          "type": "list",
          "label": "\"Why us\" points (3–4 cards with icon, title, and short text)",
          "required": false,
          "min": 0,
          "max": 6,
          "itemShape": {
            "icon": "text",
            "title": "text",
            "text": "text"
          }
        }
      ]
    },
    {
      "id": "portfolio",
      "title": "Work portfolio",
      "fields": [
        {
          "key": "galleryTitle",
          "type": "text",
          "label": "Portfolio section title (e.g. Completed work)",
          "required": false,
          "maxLen": 60
        },
        {
          "key": "categories",
          "type": "list",
          "label": "Work categories (each with title, description, and photos)",
          "required": false,
          "min": 0,
          "max": 8,
          "itemShape": {
            "title": "text",
            "blurb": "text",
            "photos": "photos"
          }
        }
      ]
    },
    {
      "id": "certifications",
      "title": "Certifications & licenses",
      "fields": [
        {
          "key": "certifications",
          "type": "list",
          "label": "Certifications / licenses (e.g. Construction license, ISO 9001)",
          "required": false,
          "min": 0,
          "max": 8,
          "itemShape": "text"
        }
      ]
    },
    {
      "id": "contact",
      "title": "Contact details",
      "fields": [
        {
          "key": "contact.title",
          "type": "text",
          "label": "Contact section title (e.g. Get a quote)",
          "required": true,
          "maxLen": 50
        },
        {
          "key": "contact.intro",
          "type": "textarea",
          "label": "Contact intro text (1–2 sentences)",
          "required": true,
          "maxLen": 200
        },
        {
          "key": "contact.phone",
          "type": "phone",
          "label": "Phone number (international format, e.g. +1 415 555 0112)",
          "required": false
        },
        {
          "key": "contact.phoneDisplay",
          "type": "text",
          "label": "Displayed phone number (e.g. +1 415 555 0112)",
          "required": false,
          "maxLen": 24
        },
        {
          "key": "contact.whatsapp",
          "type": "phone",
          "label": "WhatsApp number (no +, e.g. 14155550112)",
          "required": false
        },
        {
          "key": "contact.waMessage",
          "type": "textarea",
          "label": "WhatsApp prefilled message (plain text; diacritics OK)",
          "required": false,
          "maxLen": 300
        },
        {
          "key": "contact.waHref",
          "type": "url",
          "label": "WhatsApp link (derived — do not edit)",
          "required": false,
          "maxLen": 500
        },
        {
          "key": "contact.instagram.url",
          "type": "url",
          "label": "Instagram (contact section)",
          "required": false
        },
        {
          "key": "contact.instagram.label",
          "type": "text",
          "label": "Instagram text (e.g. @yourbusiness)",
          "required": false,
          "maxLen": 40
        },
        {
          "key": "contact.facebook.url",
          "type": "url",
          "label": "Link Facebook (opțional)",
          "required": false
        },
        {
          "key": "contact.facebook.label",
          "type": "text",
          "label": "Text link Facebook (ex. Afacerea ta)",
          "required": false,
          "maxLen": 40
        },
        {
          "key": "contact.address",
          "type": "textarea",
          "label": "Physical address (one line per row)",
          "required": false
        },
        {
          "key": "contact.addressHref",
          "type": "url",
          "label": "Google Maps link",
          "required": false
        }
      ]
    },
    {
      "id": "instagram",
      "title": "Instagram feed",
      "fields": [
        {
          "key": "instagram.handle",
          "type": "text",
          "label": "Instagram username without @ (e.g. yourbusiness)",
          "required": false,
          "maxLen": 60
        },
        {
          "key": "instagram.url",
          "type": "url",
          "label": "Instagram profile",
          "required": false
        },
        {
          "key": "instagram.embedUrl",
          "type": "url",
          "label": "URL feed Instafidget (opțional)",
          "required": false
        },
        {
          "key": "instagram.gallery",
          "type": "photos",
          "label": "Photos for the Instagram grid (6 max)",
          "required": false
        }
      ]
    },
    {
      "id": "seo",
      "title": "Partajare pe rețele sociale",
      "fields": [
        {
          "key": "seo.ogImage",
          "type": "url",
          "label": "Imagine pentru partajare socială (recomandat 1200×630px)",
          "required": false
        }
      ]
    },
    {
      "id": "footer",
      "title": "Footer",
      "fields": [
        {
          "key": "footer.address",
          "type": "text",
          "label": "Short address for the footer",
          "required": true,
          "maxLen": 120
        },
        {
          "key": "footer.year",
          "type": "text",
          "label": "Copyright year (e.g. 2026)",
          "required": true,
          "maxLen": 4
        },
        {
          "key": "footer.note",
          "type": "text",
          "label": "Footer note (e.g. Quality guaranteed.)",
          "required": false,
          "maxLen": 80
        }
      ]
    }
  ]
}
