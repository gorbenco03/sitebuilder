{
  "templateId": "local-service",
  "version": 1,
  "name": "Trades",
  "language": "en",
  "wizardHints": {
    "vertical": "local-service",
    "aiStyle": "direct, trustworthy, industrial-clean — condensed sans on headings, high anthracite/amber contrast, visible phone CTA; tone of a serious local company"
  },
  "sections": [
    {
      "id": "business",
      "title": "Despre afacere",
      "fields": [
        {
          "key": "business.name",
          "type": "text",
          "label": "Numele firmei sau al meseriei",
          "required": true,
          "maxLen": 60
        },
        {
          "key": "business.tagline",
          "type": "text",
          "label": "Slogan scurt (ex. Renovări interioare de calitate)",
          "required": true,
          "maxLen": 80
        },
        {
          "key": "business.title",
          "type": "text",
          "label": "Titlu pagină pentru browser (bara de sus)",
          "required": true,
          "maxLen": 70
        },
        {
          "key": "business.metaDescription",
          "type": "textarea",
          "label": "Descriere scurtă pentru Google (max. 160 caractere)",
          "required": true,
          "maxLen": 160
        },
        {
          "key": "business.about",
          "type": "textarea",
          "label": "Despre afacere (2–4 propoziții despre ce faci)",
          "required": true,
          "maxLen": 500
        },
        {
          "key": "business.lang",
          "type": "text",
          "label": "Limba site-ului",
          "required": true,
          "maxLen": 10
        },
        {
          "key": "business.yearsExp",
          "type": "text",
          "label": "Ani de experiență (ex. 12)",
          "required": false,
          "maxLen": 4
        },
        {
          "key": "business.projectsDone",
          "type": "text",
          "label": "Proiecte finalizate (ex. 240) — pe deschidere și la statistici",
          "required": false,
          "maxLen": 10
        },
        {
          "key": "business.zone",
          "type": "text",
          "label": "Zona de lucru (ex. București și împrejurimi)",
          "required": false,
          "maxLen": 100
        }
      ]
    },
