{
  "templateId": "local-service",
  "version": 1,
  "name": "Meseriași",
  "language": "ro",
  "wizardHints": {
    "vertical": "local-service",
    "aiStyle": "direct, de încredere, industrial-curat — sans condensat pe titluri, contrast mare antracit/chihlimbar, CTA telefon vizibil; ton de firmă locală serioasă"
  },
  "sections": [
    {
      "id": "business",
      "title": "Informații firmă",
      "fields": [
        {
          "key": "business.name",
          "type": "text",
          "label": "Numele firmei / serviciului local",
          "required": true,
          "maxLen": 60
        },
        {
          "key": "business.tagline",
          "type": "text",
          "label": "Slogan scurt (ex: Renovari interioare de calitate)",
          "required": true,
          "maxLen": 80
        },
        {
          "key": "business.title",
          "type": "text",
          "label": "Titlu pagina SEO (apare in tab browser)",
          "required": true,
          "maxLen": 70
        },
        {
          "key": "business.metaDescription",
          "type": "textarea",
          "label": "Descriere scurta pentru Google (max 160 caractere)",
          "required": true,
          "maxLen": 160
        },
        {
          "key": "business.about",
          "type": "textarea",
          "label": "Descriere firma (2-4 fraze despre ce faceti)",
          "required": true,
          "maxLen": 500
        },
        {
          "key": "business.lang",
          "type": "text",
          "label": "Limba site-ului (ro sau en)",
          "required": true,
          "maxLen": 10
        },
        {
          "key": "business.yearsExp",
          "type": "text",
          "label": "Ani de experiență (ex: 12)",
          "required": false,
          "maxLen": 4
        },
        {
          "key": "business.projectsDone",
          "type": "text",
          "label": "Număr proiecte finalizate (ex: 240) — afișat în hero și statistici",
          "required": false,
          "maxLen": 10
        },
        {
          "key": "business.zone",
          "type": "text",
          "label": "Zona de activitate (ex: Londra și împrejurimi)",
          "required": false,
          "maxLen": 100
        }
      ]
    },
    {
      "id": "labels",
      "title": "Etichete interfata (texte butoane/sectiuni)",
      "fields": [
        {
          "key": "labels.about",
          "type": "text",
          "label": "Titlu sectiune Despre noi (ex: Despre noi)",
          "required": true,
          "maxLen": 40
        },
        {
          "key": "labels.instaTitle",
          "type": "text",
          "label": "Titlu sectiune Instagram (ex: Urmariti-ne pe Instagram)",
          "required": true,
          "maxLen": 60
        },
        {
          "key": "labels.instaFollow",
          "type": "text",
          "label": "Textul butonului urmarire Instagram (ex: Urmareste)",
          "required": true,
          "maxLen": 30
        },
        {
          "key": "labels.scroll",
          "type": "text",
          "label": "Text indicator scroll (ex: Derulează)",
          "required": true,
          "maxLen": 30
        },
        {
          "key": "labels.waQr",
          "type": "text",
          "label": "Titlu modal QR WhatsApp (ex: Deschide WhatsApp pe telefon)",
          "required": true,
          "maxLen": 60
        },
        {
          "key": "labels.waOpen",
          "type": "text",
          "label": "Buton secundar WhatsApp Web (ex: Sau deschide WhatsApp Web)",
          "required": true,
          "maxLen": 60
        }
      ]
    },
    {
      "id": "visual",
      "title": "Aspect vizual",
      "fields": [
        {
          "key": "theme.primary",
          "type": "color",
          "label": "Culoare accent principala (galben-santier recomandat: #F5A623)",
          "required": true
        },
        {
          "key": "theme.primaryLight",
          "type": "color",
          "label": "Varianta mai deschisa a accentului",
          "required": true
        },
        {
          "key": "theme.primaryDark",
          "type": "color",
          "label": "Varianta mai inchisa a accentului",
          "required": true
        },
        {
          "key": "theme.cream",
          "type": "color",
          "label": "Culoare fundal pagina (gri-deschis recomandat: #F4F5F7)",
          "required": true
        },
        {
          "key": "logo",
          "type": "text",
          "label": "Cale logo (ex: images/logo.png) — lasati gol daca nu aveti",
          "required": false
        },
        {
          "key": "showWordmark",
          "type": "text",
          "label": "Aratati numele ca titlu text? (true/false, daca nu aveti logo)",
          "required": false
        }
      ]
    },
    {
      "id": "hero",
      "title": "Sectiunea Hero (banner principal)",
      "fields": [
        {
          "key": "hero.background",
          "type": "text",
          "label": "Fundal hero: cale imagine (ex: url('images/hero.jpg')) sau gradient CSS",
          "required": true
        },
        {
          "key": "hero.ctaLabel",
          "type": "text",
          "label": "Textul butonului principal (ex: Cere oferta gratuita)",
          "required": true,
          "maxLen": 40
        }
      ]
    },
    {
      "id": "services",
      "title": "Servicii oferite",
      "fields": [
        {
          "key": "servicesTitle",
          "type": "text",
          "label": "Titlu sectiune servicii (ex: Serviciile noastre)",
          "required": false,
          "maxLen": 60
        },
        {
          "key": "services",
          "type": "list",
          "label": "Lista servicii (icon emoji + denumire)",
          "required": false,
          "min": 0,
          "max": 12,
          "itemShape": {
            "icon": "text",
            "label": "text"
          }
        }
      ]
    },
    {
      "id": "trust",
      "title": "De ce noi (argumente de încredere)",
      "fields": [
        {
          "key": "trust",
          "type": "list",
          "label": "Argumente «De ce noi» (3–4 carduri cu icon, titlu și text scurt)",
          "required": false,
          "min": 0,
          "max": 6,
          "itemShape": {
            "icon": "text",
            "title": "text",
            "text": "text"
          }
        }
      ]
    },
    {
      "id": "portfolio",
      "title": "Portofoliu lucrari",
      "fields": [
        {
          "key": "galleryTitle",
          "type": "text",
          "label": "Titlu sectiune portofoliu (ex: Lucrari realizate)",
          "required": false,
          "maxLen": 60
        },
        {
          "key": "categories",
          "type": "list",
          "label": "Categorii de lucrari (fiecare cu titlu, descriere si poze)",
          "required": false,
          "min": 0,
          "max": 8,
          "itemShape": {
            "title": "text",
            "blurb": "text",
            "photos": "photos"
          }
        }
      ]
    },
    {
      "id": "certifications",
      "title": "Certificari si autorizatii",
      "fields": [
        {
          "key": "certifications",
          "type": "list",
          "label": "Certificări / autorizații (ex: Autorizație construcții, ISO 9001)",
          "required": false,
          "min": 0,
          "max": 8,
          "itemShape": "text"
        }
      ]
    },
    {
      "id": "contact",
      "title": "Date de contact",
      "fields": [
        {
          "key": "contact.title",
          "type": "text",
          "label": "Titlu sectiune contact (ex: Cere oferta)",
          "required": true,
          "maxLen": 50
        },
        {
          "key": "contact.intro",
          "type": "textarea",
          "label": "Text intro contact (1-2 fraze)",
          "required": true,
          "maxLen": 200
        },
        {
          "key": "contact.phone",
          "type": "phone",
          "label": "Telefon (format internațional, ex: +40 721 123 456)",
          "required": false
        },
        {
          "key": "contact.phoneDisplay",
          "type": "text",
          "label": "Telefon afișat (ex: +40 721 123 456)",
          "required": false,
          "maxLen": 24
        },
        {
          "key": "contact.whatsapp",
          "type": "phone",
          "label": "Număr WhatsApp (fără +, ex: 40721123456)",
          "required": false
        },
        {
          "key": "contact.waHref",
          "type": "url",
          "label": "Link WhatsApp (https://wa.me/...)",
          "required": false
        },
        {
          "key": "contact.instagram.url",
          "type": "url",
          "label": "Link Instagram",
          "required": false
        },
        {
          "key": "contact.instagram.label",
          "type": "text",
          "label": "Text link Instagram (ex: @firmamea)",
          "required": false,
          "maxLen": 40
        },
        {
          "key": "contact.facebook.url",
          "type": "url",
          "label": "Link Facebook",
          "required": false
        },
        {
          "key": "contact.facebook.label",
          "type": "text",
          "label": "Text link Facebook (ex: Firma Mea)",
          "required": false,
          "maxLen": 40
        },
        {
          "key": "contact.address",
          "type": "textarea",
          "label": "Adresa fizică (câte un rând pe linie)",
          "required": false
        },
        {
          "key": "contact.addressHref",
          "type": "url",
          "label": "Link Google Maps",
          "required": false
        }
      ]
    },
    {
      "id": "instagram",
      "title": "Instagram feed",
      "fields": [
        {
          "key": "instagram.handle",
          "type": "text",
          "label": "Username Instagram fără @ (ex: firmamea)",
          "required": false,
          "maxLen": 60
        },
        {
          "key": "instagram.url",
          "type": "url",
          "label": "Link profil Instagram",
          "required": false
        },
        {
          "key": "instagram.embedUrl",
          "type": "url",
          "label": "Link feed Instagram (opțional)",
          "required": false
        },
        {
          "key": "instagram.gallery",
          "type": "photos",
          "label": "Poze pentru grila Instagram (max 6)",
          "required": false
        }
      ]
    },
    {
      "id": "seo",
      "title": "Partajare pe rețele",
      "fields": [
        {
          "key": "seo.ogImage",
          "type": "url",
          "label": "Imagine la partajare pe rețele (1200×630px)",
          "required": false
        }
      ]
    },
    {
      "id": "footer",
      "title": "Footer",
      "fields": [
        {
          "key": "footer.address",
          "type": "text",
          "label": "Adresa scurta pentru footer",
          "required": true,
          "maxLen": 120
        },
        {
          "key": "footer.year",
          "type": "text",
          "label": "Anul pentru copyright (ex: 2026)",
          "required": true,
          "maxLen": 4
        },
        {
          "key": "footer.note",
          "type": "text",
          "label": "Nota footer (ex: Calitate garantata.)",
          "required": false,
          "maxLen": 80
        }
      ]
    }
  ]
}
