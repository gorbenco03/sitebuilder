{
  "templateId": "professionals",
  "version": 1,
  "name": "Professional services",
  "language": "en",
  "wizardHints": {
    "vertical": "professionals",
    "aiStyle": "calm editorial, premium, trustworthy — serif for large headings, warm paper and ink, no salons/restaurants/trades; the tone of a law office, consultancy, notary, accounting practice, or coach"
  },
  "sections": [
    {
      "id": "business",
      "title": "About the firm / practice",
      "fields": [
        {
          "key": "business.name",
          "type": "text",
          "label": "Name of your firm, practice, or professional brand",
          "required": true,
          "maxLen": 80
        },
        {
          "key": "business.tagline",
          "type": "text",
          "label": "Short promise (e.g., Clarity for the decisions that matter)",
          "required": true,
          "maxLen": 120
        },
        {
          "key": "business.title",
          "type": "text",
          "label": "Page title for the browser and Google",
          "required": true,
          "maxLen": 90
        },
        {
          "key": "business.metaDescription",
          "type": "textarea",
          "label": "SEO description (1–2 sentences, no made-up rankings)",
          "required": true,
          "maxLen": 160
        },
        {
          "key": "business.about",
          "type": "textarea",
          "label": "About you or your team — your approach, not unverifiable numbers",
          "required": true,
          "maxLen": 700
        },
        {
          "key": "business.lang",
          "type": "text",
          "label": "Site language",
          "required": true,
          "maxLen": 5
        },
        {
          "key": "business.profession",
          "type": "text",
          "label": "Profession or credential (e.g., Attorney, Financial consultant) — optional",
          "required": false,
          "maxLen": 80
        },
        {
          "key": "business.languages",
          "type": "text",
          "label": "Languages you work in (e.g., English, Spanish) — optional",
          "required": false,
          "maxLen": 80
        },
        {
          "key": "business.modes",
          "type": "text",
          "label": "How you work (e.g., Online and in-office) — optional",
          "required": false,
          "maxLen": 80
        }
      ]
    },
    {
      "id": "labels",
      "title": "Button and section text",
      "fields": [
        {
          "key": "labels.navServices",
          "type": "text",
          "label": "Services nav link",
          "required": true,
          "maxLen": 24
        },
        {
          "key": "labels.navAbout",
          "type": "text",
          "label": "About nav link",
          "required": true,
          "maxLen": 24
        },
        {
          "key": "labels.navFaq",
          "type": "text",
          "label": "FAQ nav link",
          "required": true,
          "maxLen": 24
        },
        {
          "key": "labels.navContact",
          "type": "text",
          "label": "Contact nav link",
          "required": true,
          "maxLen": 24
        },
        {
          "key": "labels.navBook",
          "type": "text",
          "label": "Booking nav link",
          "required": true,
          "maxLen": 24
        },
        {
          "key": "labels.servicesEyebrow",
          "type": "text",
          "label": "Small label above the services section",
          "required": true,
          "maxLen": 40
        },
        {
          "key": "labels.processEyebrow",
          "type": "text",
          "label": "Small label above the process section",
          "required": true,
          "maxLen": 40
        },
        {
          "key": "labels.aboutEyebrow",
          "type": "text",
          "label": "Small label above the about section",
          "required": true,
          "maxLen": 40
        },
        {
          "key": "labels.faqEyebrow",
          "type": "text",
          "label": "Small label above the FAQ section",
          "required": true,
          "maxLen": 40
        },
        {
          "key": "labels.bookEyebrow",
          "type": "text",
          "label": "Small label above the booking section",
          "required": true,
          "maxLen": 40
        },
        {
          "key": "labels.contactEyebrow",
          "type": "text",
          "label": "Small label above the contact section",
          "required": true,
          "maxLen": 40
        },
        {
          "key": "labels.secondaryCta",
          "type": "text",
          "label": "Secondary hero button (e.g., See our services)",
          "required": true,
          "maxLen": 40
        },
        {
          "key": "labels.scroll",
          "type": "text",
          "label": "Scroll indicator on the hero",
          "required": true,
          "maxLen": 20
        },
        {
          "key": "labels.instaTitle",
          "type": "text",
          "label": "Instagram section title (if enabled)",
          "required": false,
          "maxLen": 60
        },
        {
          "key": "labels.instaFollow",
          "type": "text",
          "label": "Instagram follow button",
          "required": false,
          "maxLen": 24
        },
        {
          "key": "labels.waQr",
          "type": "text",
          "label": "WhatsApp QR modal title",
          "required": false,
          "maxLen": 60
        },
        {
          "key": "labels.waOpen",
          "type": "text",
          "label": "\"Open WhatsApp Web\" link text",
          "required": false,
          "maxLen": 60
        },
        {
          "key": "labels.whatsapp",
          "type": "text",
          "label": "WhatsApp link label (contact section)",
          "required": false,
          "maxLen": 24
        },
        {
          "key": "labels.close",
          "type": "text",
          "label": "Close button label (accessibility)",
          "required": false,
          "maxLen": 24
        },
        {
          "key": "labels.apptTypeLegend",
          "type": "text",
          "label": "Appointment form: type of consultation legend",
          "required": false,
          "maxLen": 60
        },
        {
          "key": "labels.apptDate",
          "type": "text",
          "label": "Appointment form: date label",
          "required": false,
          "maxLen": 24
        },
        {
          "key": "labels.apptTime",
          "type": "text",
          "label": "Appointment form: time label",
          "required": false,
          "maxLen": 24
        },
        {
          "key": "labels.apptName",
          "type": "text",
          "label": "Appointment form: name label",
          "required": false,
          "maxLen": 24
        },
        {
          "key": "labels.apptEmail",
          "type": "text",
          "label": "Appointment form: email label",
          "required": false,
          "maxLen": 24
        },
        {
          "key": "labels.apptPhone",
          "type": "text",
          "label": "Appointment form: phone label (include optional hint)",
          "required": false,
          "maxLen": 48
        },
        {
          "key": "labels.apptNote",
          "type": "text",
          "label": "Appointment form: note label (include optional hint)",
          "required": false,
          "maxLen": 80
        },
        {
          "key": "labels.apptDoneTitle",
          "type": "text",
          "label": "Appointment form: success title after submit",
          "required": false,
          "maxLen": 80
        },
        {
          "key": "labels.apptAltChannel",
          "type": "text",
          "label": "Appointment form: alternate channel prompt",
          "required": false,
          "maxLen": 60
        }
      ]
    },
    {
      "id": "theme",
      "title": "Colors & visual theme",
      "fields": [
        {
          "key": "theme.primary",
          "type": "color",
          "label": "Primary accent (muted brass / terracotta)",
          "required": true
        },
        {
          "key": "theme.primaryLight",
          "type": "color",
          "label": "Light accent",
          "required": true
        },
        {
          "key": "theme.primaryDark",
          "type": "color",
          "label": "Ink / primary text color",
          "required": true
        },
        {
          "key": "theme.cream",
          "type": "color",
          "label": "Paper / warm background",
          "required": true
        }
      ]
    },
    {
      "id": "hero",
      "title": "Hero",
      "fields": [
        {
          "key": "hero.ctaLabel",
          "type": "text",
          "label": "Primary button (e.g., Book a consultation)",
          "required": true,
          "maxLen": 40
        },
        {
          "key": "hero.qualifier",
          "type": "text",
          "label": "Short qualifier below the tagline",
          "required": false,
          "maxLen": 140
        },
        {
          "key": "hero.background",
          "type": "background",
          "label": "Hero background",
          "hint": "Pick a color and optional photo. The live preview updates immediately.",
          "required": false,
          "maxLen": 2000
        }
      ]
    },
    {
      "id": "services",
      "title": "Services / expertise",
      "fields": [
        {
          "key": "servicesTitle",
          "type": "text",
          "label": "Services section title",
          "required": true,
          "maxLen": 60
        },
        {
          "key": "services",
          "type": "list",
          "label": "Services (name + short description)",
          "required": true,
          "min": 1,
          "max": 8,
          "itemShape": {
            "label": "text",
            "blurb": "text"
          }
        }
      ]
    },
    {
      "id": "process",
      "title": "How you work",
      "fields": [
        {
          "key": "process.title",
          "type": "text",
          "label": "Process section title",
          "required": false,
          "maxLen": 60
        },
        {
          "key": "process.steps",
          "type": "list",
          "label": "Steps (title + text) — you request, you don't auto-confirm",
          "required": false,
          "min": 0,
          "max": 5,
          "itemShape": {
            "title": "text",
            "text": "text"
          }
        }
      ]
    },
    {
      "id": "credentials",
      "title": "Credentials (no unverifiable claims)",
      "fields": [
        {
          "key": "credentials.title",
          "type": "text",
          "label": "Credentials section title",
          "required": false,
          "maxLen": 60
        },
        {
          "key": "credentials.lead",
          "type": "textarea",
          "label": "Intro line (e.g., Experience, rigor, and straight talk)",
          "required": false,
          "maxLen": 300
        },
        {
          "key": "credentials.items",
          "type": "list",
          "label": "Bullet points (qualifications, focus areas) — only what's real",
          "required": false,
          "min": 0,
          "max": 8,
          "itemShape": {
            "label": "text"
          }
        }
      ]
    },
    {
      "id": "faq",
      "title": "Frequently asked questions",
      "fields": [
        {
          "key": "faq.title",
          "type": "text",
          "label": "FAQ section title",
          "required": false,
          "maxLen": 60
        },
        {
          "key": "faq.items",
          "type": "list",
          "label": "Question + answer",
          "required": false,
          "min": 0,
          "max": 10,
          "itemShape": {
            "q": "text",
            "a": "text"
          }
        }
      ]
    },
    {
      "id": "appointment",
      "title": "Appointments (local request, no external calendar)",
      "fields": [
        {
          "key": "appointment.enabled",
          "type": "text",
          "label": "Enable the appointment section (yes / no)",
          "required": true,
          "maxLen": 8
        },
        {
          "key": "appointment.title",
          "type": "text",
          "label": "Section title (e.g., Request an appointment)",
          "required": true,
          "maxLen": 80
        },
        {
          "key": "appointment.intro",
          "type": "textarea",
          "label": "Intro text — make clear it's a request, not an automatic confirmation",
          "required": true,
          "maxLen": 400
        },
        {
          "key": "appointment.timezone",
          "type": "text",
          "label": "Displayed time zone (e.g., America/New_York)",
          "required": true,
          "maxLen": 40
        },
        {
          "key": "appointment.slotIntervalMinutes",
          "type": "text",
          "label": "Slot interval in minutes (e.g., 60)",
          "required": true,
          "maxLen": 4
        },
        {
          "key": "appointment.durationMin",
          "type": "text",
          "label": "Default consultation length (minutes)",
          "required": true,
          "maxLen": 4
        },
        {
          "key": "appointment.minLeadMinutes",
          "type": "text",
          "label": "Minimum notice before the first slot (minutes)",
          "required": true,
          "maxLen": 6
        },
        {
          "key": "appointment.modeLabel",
          "type": "text",
          "label": "Default format (e.g., Online or in-office)",
          "required": false,
          "maxLen": 60
        },
        {
          "key": "appointment.types",
          "type": "list",
          "label": "Consultation types",
          "required": true,
          "min": 1,
          "max": 6,
          "itemShape": {
            "id": "text",
            "label": "text",
            "durationMin": "text",
            "mode": "text"
          }
        },
        {
          "key": "appointment.weekly",
          "type": "list",
          "label": "Weekly availability (weekday 1=Mon…7=Sun, start, end HH:MM)",
          "required": true,
          "min": 1,
          "max": 14,
          "itemShape": {
            "weekday": "text",
            "start": "text",
            "end": "text"
          }
        },
        {
          "key": "appointment.confirmationText",
          "type": "textarea",
          "label": "Message shown after the request is sent",
          "required": true,
          "maxLen": 280
        },
        {
          "key": "appointment.privacyNotice",
          "type": "textarea",
          "label": "Privacy note / personal data",
          "required": false,
          "maxLen": 280
        },
        {
          "key": "appointment.confidentialityWarning",
          "type": "textarea",
          "label": "Warning (legal/accounting): don't send confidential documents here",
          "required": false,
          "maxLen": 280
        },
        {
          "key": "appointment.emptySlotsText",
          "type": "textarea",
          "label": "Message shown when no slots are available",
          "required": false,
          "maxLen": 200
        },
        {
          "key": "appointment.submitLabel",
          "type": "text",
          "label": "Submit button text",
          "required": true,
          "maxLen": 40
        }
      ]
    },
    {
      "id": "contact",
      "title": "Contact & location",
      "fields": [
        {
          "key": "contact.title",
          "type": "text",
          "label": "Contact section title",
          "required": true,
          "maxLen": 60
        },
        {
          "key": "contact.intro",
          "type": "textarea",
          "label": "Contact intro (mention online consultations if offered)",
          "required": true,
          "maxLen": 400
        },
        {
          "key": "contact.phone",
          "type": "phone",
          "label": "Phone (international format)",
          "required": false,
          "maxLen": 20
        },
        {
          "key": "contact.phoneDisplay",
          "type": "text",
          "label": "Displayed phone number",
          "required": false,
          "maxLen": 30
        },
        {
          "key": "contact.email",
          "type": "email",
          "label": "Contact email",
          "required": false,
          "maxLen": 80
        },
        {
          "key": "contact.whatsapp",
          "type": "phone",
          "label": "WhatsApp (international digits)",
          "required": false,
          "maxLen": 20
        },
        {
          "key": "contact.waMessage",
          "type": "textarea",
          "label": "WhatsApp prefilled message (plain text; diacritics OK)",
          "required": false,
          "maxLen": 300
        },
        {
          "key": "contact.waHref",
          "type": "url",
          "label": "WhatsApp link (derived — do not edit)",
          "required": false,
          "maxLen": 500
        },
        {
          "key": "contact.address",
          "type": "textarea",
          "label": "Office address",
          "required": false,
          "maxLen": 200
        },
        {
          "key": "contact.addressHref",
          "type": "url",
          "label": "Map link (optional)",
          "required": false,
          "maxLen": 300
        },
        {
          "key": "contact.hoursNote",
          "type": "text",
          "label": "Office hours note (free text)",
          "required": false,
          "maxLen": 120
        },
        {
          "key": "contact.instagram.url",
          "type": "url",
          "label": "Instagram (contact section)",
          "required": false,
          "maxLen": 200
        },
        {
          "key": "contact.instagram.label",
          "type": "text",
          "label": "Instagram label",
          "required": false,
          "maxLen": 40
        },
        {
          "key": "contact.facebook.url",
          "type": "url",
          "label": "Facebook link",
          "required": false,
          "maxLen": 200
        },
        {
          "key": "contact.facebook.label",
          "type": "text",
          "label": "Facebook label",
          "required": false,
          "maxLen": 40
        }
      ]
    },
    {
      "id": "instagram",
      "title": "Instagram (optional)",
      "fields": [
        {
          "key": "instagram.handle",
          "type": "text",
          "label": "Instagram handle (without @)",
          "required": false,
          "maxLen": 40
        },
        {
          "key": "instagram.url",
          "type": "url",
          "label": "Instagram profile",
          "required": false,
          "maxLen": 200
        },
        {
          "key": "instagram.embedUrl",
          "type": "url",
          "label": "Instafidget feed URL (optional)",
          "required": false,
          "maxLen": 400
        },
        {
          "key": "instagram.gallery",
          "type": "list",
          "label": "Instagram gallery photos (URLs or images/...)",
          "required": false,
          "min": 0,
          "max": 12,
          "itemShape": {
            ".": "text"
          }
        }
      ]
    },
    {
      "id": "seo",
      "title": "Search details",
      "fields": [
        {
          "key": "seo.ogImage",
          "type": "text",
          "label": "Share image (images/... or URL)",
          "required": false,
          "maxLen": 300
        }
      ]
    },
    {
      "id": "footer",
      "title": "Footer",
      "fields": [
        {
          "key": "footer.address",
          "type": "text",
          "label": "Short address in the footer",
          "required": false,
          "maxLen": 120
        },
        {
          "key": "footer.year",
          "type": "text",
          "label": "Copyright year",
          "required": true,
          "maxLen": 6
        },
        {
          "key": "footer.note",
          "type": "text",
          "label": "Short footer note",
          "required": false,
          "maxLen": 120
        }
      ]
    }
  ]
}
