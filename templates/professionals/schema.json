{
  "templateId": "professionals",
  "version": 1,
  "name": "Professional services",
  "language": "en",
  "wizardHints": {
    "vertical": "professionals",
    "aiStyle": "calm editorial, premium, trustworthy — serif for large headings, warm paper and ink, no salons/restaurants/trades; the tone of a law office, consultancy, notary, accounting practice, or coach"
