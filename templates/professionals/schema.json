    {
      "id": "business",
      "title": "Despre firmă / cabinet",
      "fields": [
        {
          "key": "business.name",
          "type": "text",
          "label": "Numele firmei, cabinetului sau brandului profesional",
          "required": true,
          "maxLen": 80
        },
        {
          "key": "business.tagline",
          "type": "text",
          "label": "Promisiune scurtă (ex. Claritate pentru deciziile care contează)",
          "required": true,
          "maxLen": 120
