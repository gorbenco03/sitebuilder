{
  "templateId": "portfolio",
  "version": 1,
  "name": "Salon",
  "language": "en",
  "wizardHints": {
    "vertical": "portfolio",
    "aiStyle": "editorial, gallery-first, elegant — thin serif on headings, generous whitespace, large photography; tone of a studio/salon/artist, not an admin form"
  },
  "sections": [
    {
      "id": "business",
      "title": "About the salon",
      "fields": [
        {
          "key": "business.name",
          "type": "text",
          "label": "Studio, salon, or brand name",
          "required": true,
          "maxLen": 60
        },
        {
          "key": "business.tagline",
          "type": "text",
          "label": "Short tagline (e.g. Real beauty, heartfelt care)",
          "required": true,
          "maxLen": 100
        },
        {
          "key": "business.title",
          "type": "text",
          "label": "Page title for the browser tab and Google",
          "required": true,
          "maxLen": 80
        },
        {
          "key": "business.metaDescription",
          "type": "textarea",
          "label": "SEO description (1–2 sentences about services and location)",
          "required": true,
          "maxLen": 160
        },
        {
          "key": "business.about",
          "type": "textarea",
          "label": "The salon's story — the \"About us\" section",
          "required": true,
          "maxLen": 600
        },
        {
          "key": "business.lang",
          "type": "text",
          "label": "Site language",
          "required": true,
          "maxLen": 5
        }
      ]
    },
    {
      "id": "labels",
      "title": "Interface labels",
      "fields": [
        {
          "key": "labels.about",
          "type": "text",
          "label": "\"About us\" section title",
          "required": true,
          "maxLen": 40
        },
        {
          "key": "labels.instaTitle",
          "type": "text",
          "label": "Instagram section title",
          "required": true,
          "maxLen": 60
        },
        {
          "key": "labels.instaFollow",
          "type": "text",
          "label": "Instagram follow button text",
          "required": true,
          "maxLen": 20
        },
        {
          "key": "labels.scroll",
          "type": "text",
          "label": "Scroll indicator text on the hero",
          "required": true,
          "maxLen": 20
        },
        {
          "key": "labels.waQr",
          "type": "text",
          "label": "WhatsApp QR modal title",
          "required": true,
          "maxLen": 60
        },
        {
          "key": "labels.waOpen",
          "type": "text",
          "label": "\"Open WhatsApp Web\" link text",
          "required": true,
          "maxLen": 60
        },
        {
          "key": "labels.servicesEyebrow",
          "type": "text",
          "label": "Small label above the services section (e.g. Service menu)",
          "required": true,
          "maxLen": 40
        },
        {
          "key": "labels.scheduleEyebrow",
          "type": "text",
          "label": "Small label above the hours section (e.g. Hours)",
          "required": true,
          "maxLen": 40
        },
        {
          "key": "labels.galleryEyebrow",
          "type": "text",
          "label": "Small label above the gallery (e.g. Our work)",
          "required": true,
          "maxLen": 40
        },
        {
          "key": "labels.teamEyebrow",
          "type": "text",
          "label": "Small label above the team section (e.g. Our team)",
          "required": true,
          "maxLen": 40
        },
        {
          "key": "labels.bookingEyebrow",
          "type": "text",
          "label": "Small label above the contact section (e.g. Bookings)",
          "required": true,
          "maxLen": 40
        },
        {
          "key": "labels.waBookBtn",
          "type": "text",
          "label": "WhatsApp button text in the contact section (e.g. Book on WhatsApp)",
          "required": true,
          "maxLen": 60
        },
        {
          "key": "labels.navGallery",
          "type": "text",
          "label": "Gallery nav link (e.g. Gallery)",
          "required": true,
          "maxLen": 24
        },
        {
          "key": "labels.navServices",
          "type": "text",
          "label": "Services nav link (e.g. Services)",
          "required": true,
          "maxLen": 24
        },
        {
          "key": "labels.navBooking",
          "type": "text",
          "label": "Booking nav link (e.g. Booking)",
          "required": true,
          "maxLen": 24
        },
        {
          "key": "labels.aboutCap",
          "type": "text",
          "label": "Short label next to \"About\" (e.g. Salon / Studio)",
          "required": false,
          "maxLen": 24
        }
      ]
    },
    {
      "id": "theme",
      "title": "Colors & visual theme",
      "fields": [
        {
          "key": "theme.primary",
          "type": "color",
          "label": "Primary color — gold-beige accent (e.g. #C4956A)",
          "required": true
        },
        {
          "key": "theme.primaryLight",
          "type": "color",
          "label": "Lighter accent shade (e.g. #D9B08C)",
          "required": true
        },
        {
          "key": "theme.primaryDark",
          "type": "color",
          "label": "Darker accent shade (e.g. #A07548)",
          "required": true
        },
        {
          "key": "theme.cream",
          "type": "color",
          "label": "Background color (nude cream, e.g. #FAF7F4)",
          "required": true
        }
      ]
    },
    {
      "id": "hero",
      "title": "Hero section",
      "fields": [
        {
          "key": "logo",
          "type": "text",
          "label": "Logo image path (e.g. images/logo.png) or leave blank",
          "required": false,
          "maxLen": 200
        },
        {
          "key": "showWordmark",
          "type": "text",
          "label": "Show the name as text on the hero if you don't have a logo? (true / false)",
          "required": false
        },
        {
          "key": "hero.background",
          "type": "background",
          "label": "Hero background",
          "hint": "Pick a color and optional photo. The live preview updates immediately.",
          "required": true,
          "maxLen": 2000
        },
        {
          "key": "hero.ctaLabel",
          "type": "text",
          "label": "Main button text (e.g. Book now)",
          "required": true,
          "maxLen": 40
        }
      ]
    },
    {
      "id": "services",
      "title": "Services & pricing",
      "fields": [
        {
          "key": "servicesTitle",
          "type": "text",
          "label": "Services menu title (e.g. Our services)",
          "required": false,
          "maxLen": 60
        },
        {
          "key": "services",
          "type": "list",
          "label": "Services list (SVG icon + name + optional price)",
          "required": false,
          "min": 0,
          "max": 16,
          "itemShape": {
            "icon": "text",
            "label": "text",
            "price": "text"
          }
        },
        {
          "key": "pricing",
          "type": "list",
          "label": "Detailed price list (optional — shown in addition to the services list)",
          "required": false,
          "min": 0,
          "max": 20,
          "itemShape": {
            "name": "text",
            "price": "text"
          }
        }
      ]
    },
    {
      "id": "schedule",
      "title": "Business hours (optional)",
      "fields": [
        {
          "key": "schedule.title",
          "type": "text",
          "label": "Hours section title (e.g. Business hours)",
          "required": false,
          "maxLen": 60
        },
        {
          "key": "schedule.rows",
          "type": "list",
          "label": "Hours rows (day + hours)",
          "required": false,
          "min": 0,
          "max": 7,
          "itemShape": {
            "day": "text",
            "hours": "text"
          }
        }
      ]
    },
    {
      "id": "gallery",
      "title": "Work gallery",
      "fields": [
        {
          "key": "galleryTitle",
          "type": "text",
          "label": "Gallery section title (e.g. Our portfolio) or leave blank",
          "required": false,
          "maxLen": 60
        },
        {
          "key": "categories",
          "type": "list",
          "label": "Work categories (e.g. Nails, Hair, Makeup)",
          "required": true,
          "min": 1,
          "max": 6,
          "itemShape": {
            "title": "text",
            "blurb": "text",
            "photos": "photos"
          }
        }
      ]
    },
    {
      "id": "team",
      "title": "Team (optional)",
      "fields": [
        {
          "key": "team.title",
          "type": "text",
          "label": "Team section title (e.g. Our team)",
          "required": false,
          "maxLen": 60
        },
        {
          "key": "team.members",
          "type": "list",
          "label": "Team members",
          "required": false,
          "min": 0,
          "max": 8,
          "itemShape": {
            "name": "text",
            "role": "text",
            "bio": "text",
            "photo": "text"
          }
        }
      ]
    },
    {
      "id": "instagram",
      "title": "Instagram",
      "fields": [
        {
          "key": "instagram.handle",
          "type": "text",
          "label": "Instagram username (no @)",
          "required": false,
          "maxLen": 60
        },
        {
          "key": "instagram.url",
          "type": "url",
          "label": "Instagram URL (https://www.instagram.com/...)",
          "required": false
        },
        {
          "key": "instagram.embedUrl",
          "type": "url",
          "label": "Instagram feed link (optional)",
          "required": false
        },
        {
          "key": "instagram.gallery",
          "type": "photos",
          "label": "Instagram grid photos (results / fallback)",
          "required": false
        }
      ]
    },
    {
      "id": "contact",
      "title": "Contact & bookings",
      "fields": [
        {
          "key": "contact.title",
          "type": "text",
          "label": "Contact section title (e.g. Book an appointment)",
          "required": true,
          "maxLen": 50
        },
        {
          "key": "contact.intro",
          "type": "textarea",
          "label": "Intro text for contact / booking",
          "required": true,
          "maxLen": 200
        },
        {
          "key": "contact.whatsapp",
          "type": "phone",
          "label": "WhatsApp number (international format, no +, e.g. 14155550112)",
          "required": false
        },
        {
          "key": "contact.waHref",
          "type": "url",
          "label": "WhatsApp link with pre-filled message (https://wa.me/...)",
          "required": false
        },
        {
          "key": "contact.phone",
          "type": "phone",
          "label": "Phone number (with country code, e.g. +14155550112)",
          "required": false
        },
        {
          "key": "contact.phoneDisplay",
          "type": "text",
          "label": "Displayed phone number (e.g. +1 415 555 0112)",
          "required": false,
          "maxLen": 30
        },
        {
          "key": "contact.instagram.url",
          "type": "url",
          "label": "Instagram (contact section)",
          "required": false
        },
        {
          "key": "contact.instagram.label",
          "type": "text",
          "label": "Instagram text (e.g. @yoursalon)",
          "required": false,
          "maxLen": 60
        },
        {
          "key": "contact.facebook.url",
          "type": "url",
          "label": "Facebook link (optional)",
          "required": false
        },
        {
          "key": "contact.facebook.label",
          "type": "text",
          "label": "Facebook link text",
          "required": false,
          "maxLen": 60
        },
        {
          "key": "contact.address",
          "type": "textarea",
          "label": "Physical address (one line per row)",
          "required": false,
          "maxLen": 200
        },
        {
          "key": "contact.addressHref",
          "type": "url",
          "label": "Google Maps link for the address",
          "required": false
        }
      ]
    },
    {
      "id": "seo",
      "title": "SEO & social sharing",
      "fields": [
        {
          "key": "seo.ogImage",
          "type": "url",
          "label": "Social sharing image",
          "required": false
        }
      ]
    },
    {
      "id": "footer",
      "title": "Footer",
      "fields": [
        {
          "key": "footer.address",
          "type": "text",
          "label": "Short address for the footer",
          "required": true,
          "maxLen": 120
        },
        {
          "key": "footer.year",
          "type": "text",
          "label": "Copyright year (e.g. 2026)",
          "required": true,
          "maxLen": 4
        },
        {
          "key": "footer.note",
          "type": "text",
          "label": "Small footer note (e.g. Beauty with heart.)",
          "required": false,
          "maxLen": 100
        }
      ]
    }
  ]
}
