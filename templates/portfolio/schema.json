{
  "templateId": "portfolio",
  "version": 1,
  "name": "Salon",
  "language": "ro",
  "wizardHints": {
    "vertical": "portfolio",
    "aiStyle": "editorial, galerie-first, elegant — serif subțire pe titluri, spațiu generos, fotografie mare; ton de studio/salon/artist, nu de formular admin"
  },
  "sections": [
    {
      "id": "business",
      "title": "Despre salon",
      "fields": [
        {
          "key": "business.name",
          "type": "text",
          "label": "Numele studioului / salonului / brandului",
          "required": true,
          "maxLen": 60
        },
        {
          "key": "business.tagline",
          "type": "text",
          "label": "Slogan scurt (ex: Frumusețe autentică, îngrijire cu suflet)",
          "required": true,
          "maxLen": 100
        },
        {
          "key": "business.title",
          "type": "text",
          "label": "Titlul paginii pentru browser și Google",
          "required": true,
          "maxLen": 80
        },
        {
          "key": "business.metaDescription",
          "type": "textarea",
          "label": "Descriere SEO (1–2 propoziții despre servicii și localitate)",
          "required": true,
          "maxLen": 160
        },
        {
          "key": "business.about",
          "type": "textarea",
          "label": "Povestea salonului — secțiunea «Despre noi»",
          "required": true,
          "maxLen": 600
        },
        {
          "key": "business.lang",
          "type": "text",
          "label": "Limba site-ului",
          "required": true,
          "maxLen": 5
        }
      ]
    },
    {
      "id": "labels",
      "title": "Etichete interfață",
      "fields": [
        {
          "key": "labels.about",
          "type": "text",
          "label": "Titlul secțiunii «Despre noi»",
          "required": true,
          "maxLen": 40
        },
        {
          "key": "labels.instaTitle",
          "type": "text",
          "label": "Titlul secțiunii Instagram",
          "required": true,
          "maxLen": 60
        },
        {
          "key": "labels.instaFollow",
          "type": "text",
          "label": "Textul butonului de follow Instagram",
          "required": true,
          "maxLen": 20
        },
        {
          "key": "labels.scroll",
          "type": "text",
          "label": "Textul indicatorului de scroll pe hero",
          "required": true,
          "maxLen": 20
        },
        {
          "key": "labels.waQr",
          "type": "text",
          "label": "Titlul modalului QR WhatsApp",
          "required": true,
          "maxLen": 60
        },
        {
          "key": "labels.waOpen",
          "type": "text",
          "label": "Textul linkului «Deschide WhatsApp Web»",
          "required": true,
          "maxLen": 60
        },
        {
          "key": "labels.servicesEyebrow",
          "type": "text",
          "label": "Textul mic deasupra secțiunii servicii (ex: Meniu servicii)",
          "required": true,
          "maxLen": 40
        },
        {
          "key": "labels.scheduleEyebrow",
          "type": "text",
          "label": "Textul mic deasupra secțiunii program (ex: Program)",
          "required": true,
          "maxLen": 40
        },
        {
          "key": "labels.galleryEyebrow",
          "type": "text",
          "label": "Textul mic deasupra galeriei (ex: Lucrările noastre)",
          "required": true,
          "maxLen": 40
        },
        {
          "key": "labels.teamEyebrow",
          "type": "text",
          "label": "Textul mic deasupra secțiunii echipă (ex: Echipa noastră)",
          "required": true,
          "maxLen": 40
        },
        {
          "key": "labels.bookingEyebrow",
          "type": "text",
          "label": "Textul mic deasupra secțiunii contact (ex: Rezervări)",
          "required": true,
          "maxLen": 40
        },
        {
          "key": "labels.waBookBtn",
          "type": "text",
          "label": "Textul butonului WhatsApp din secțiunea contact (ex: Rezervă pe WhatsApp)",
          "required": true,
          "maxLen": 60
        },
        {
          "key": "labels.navGallery",
          "type": "text",
          "label": "Link navigare galerie (ex: Galerie)",
          "required": true,
          "maxLen": 24
        },
        {
          "key": "labels.navServices",
          "type": "text",
          "label": "Link navigare servicii (ex: Servicii)",
          "required": true,
          "maxLen": 24
        },
        {
          "key": "labels.navBooking",
          "type": "text",
          "label": "Link navigare programare (ex: Programare)",
          "required": true,
          "maxLen": 24
        },
        {
          "key": "labels.aboutCap",
          "type": "text",
          "label": "Etichetă scurtă lângă «Despre» (ex: Salon / Atelier — nu engleză factory)",
          "required": false,
          "maxLen": 24
        }
      ]
    },
    {
      "id": "theme",
      "title": "Culori & temă vizuală",
      "fields": [
        {
          "key": "theme.primary",
          "type": "color",
          "label": "Culoarea principală — accent auriu-bej (ex: #C4956A)",
          "required": true
        },
        {
          "key": "theme.primaryLight",
          "type": "color",
          "label": "Varianta deschisă a accentului (ex: #D9B08C)",
          "required": true
        },
        {
          "key": "theme.primaryDark",
          "type": "color",
          "label": "Varianta închisă a accentului (ex: #A07548)",
          "required": true
        },
        {
          "key": "theme.cream",
          "type": "color",
          "label": "Culoarea de fond (crem nude, ex: #FAF7F4)",
          "required": true
        }
      ]
    },
    {
      "id": "hero",
      "title": "Secțiunea hero",
      "fields": [
        {
          "key": "logo",
          "type": "text",
          "label": "Calea imaginii logo (ex: images/logo.png) sau lasă gol",
          "required": false,
          "maxLen": 200
        },
        {
          "key": "showWordmark",
          "type": "text",
          "label": "Afișează numele ca text pe hero dacă nu ai logo? (true / false)",
          "required": false
        },
        {
          "key": "hero.background",
          "type": "text",
          "label": "Fundalul heroului — url('images/hero.jpg') sau gradient CSS",
          "required": true,
          "maxLen": 300
        },
        {
          "key": "hero.ctaLabel",
          "type": "text",
          "label": "Textul butonului principal (ex: Rezervă acum)",
          "required": true,
          "maxLen": 40
        }
      ]
    },
    {
      "id": "services",
      "title": "Servicii & prețuri",
      "fields": [
        {
          "key": "servicesTitle",
          "type": "text",
          "label": "Titlul meniului de servicii (ex: Serviciile noastre)",
          "required": false,
          "maxLen": 60
        },
        {
          "key": "services",
          "type": "list",
          "label": "Lista serviciilor (icon SVG + denumire + preț opțional)",
          "required": false,
          "min": 0,
          "max": 16,
          "itemShape": {
            "icon": "text",
            "label": "text",
            "price": "text"
          }
        },
        {
          "key": "pricing",
          "type": "list",
          "label": "Tabel de prețuri detaliat (opțional — afișat în plus față de lista de servicii)",
          "required": false,
          "min": 0,
          "max": 20,
          "itemShape": {
            "name": "text",
            "price": "text"
          }
        }
      ]
    },
    {
      "id": "schedule",
      "title": "Program de lucru (opțional)",
      "fields": [
        {
          "key": "schedule.title",
          "type": "text",
          "label": "Titlul secțiunii program (ex: Program de lucru)",
          "required": false,
          "maxLen": 60
        },
        {
          "key": "schedule.rows",
          "type": "list",
          "label": "Rânduri program (zi + ore)",
          "required": false,
          "min": 0,
          "max": 7,
          "itemShape": {
            "day": "text",
            "hours": "text"
          }
        }
      ]
    },
    {
      "id": "gallery",
      "title": "Galerie lucrări",
      "fields": [
        {
          "key": "galleryTitle",
          "type": "text",
          "label": "Titlul secțiunii galerie (ex: Portofoliul nostru) sau lasă gol",
          "required": false,
          "maxLen": 60
        },
        {
          "key": "categories",
          "type": "list",
          "label": "Categorii de lucrări (ex: Manichiură, Coafuri, Make-up)",
          "required": true,
          "min": 1,
          "max": 6,
          "itemShape": {
            "title": "text",
            "blurb": "text",
            "photos": "photos"
          }
        }
      ]
    },
    {
      "id": "team",
      "title": "Echipa (opțional)",
      "fields": [
        {
          "key": "team.title",
          "type": "text",
          "label": "Titlul secțiunii echipă (ex: Echipa noastră)",
          "required": false,
          "maxLen": 60
        },
        {
          "key": "team.members",
          "type": "list",
          "label": "Membrii echipei",
          "required": false,
          "min": 0,
          "max": 8,
          "itemShape": {
            "name": "text",
            "role": "text",
            "bio": "text",
            "photo": "text"
          }
        }
      ]
    },
    {
      "id": "instagram",
      "title": "Instagram",
      "fields": [
        {
          "key": "instagram.handle",
          "type": "text",
          "label": "Username Instagram (fără @)",
          "required": false,
          "maxLen": 60
        },
        {
          "key": "instagram.url",
          "type": "url",
          "label": "Adresa Instagram (https://www.instagram.com/...)",
          "required": false
        },
        {
          "key": "instagram.embedUrl",
          "type": "url",
          "label": "Feed Instagram (opțional)",
          "required": false
        },
        {
          "key": "instagram.gallery",
          "type": "photos",
          "label": "Poze grilă Instagram (rezultate / fallback)",
          "required": false
        }
      ]
    },
    {
      "id": "contact",
      "title": "Contact & rezervări",
      "fields": [
        {
          "key": "contact.title",
          "type": "text",
          "label": "Titlul secțiunii de contact (ex: Rezervă o programare)",
          "required": true,
          "maxLen": 50
        },
        {
          "key": "contact.intro",
          "type": "textarea",
          "label": "Textul introductiv pentru contact / rezervare",
          "required": true,
          "maxLen": 200
        },
        {
          "key": "contact.whatsapp",
          "type": "phone",
          "label": "Număr WhatsApp (format internațional fără +, ex: 40721000000)",
          "required": false
        },
        {
          "key": "contact.waHref",
          "type": "url",
          "label": "Link WhatsApp cu mesaj precompletat (https://wa.me/...)",
          "required": false
        },
        {
          "key": "contact.phone",
          "type": "phone",
          "label": "Număr de telefon (cu prefix, ex: +40721000000)",
          "required": false
        },
        {
          "key": "contact.phoneDisplay",
          "type": "text",
          "label": "Numărul de telefon afișat (ex: +40 721 000 000)",
          "required": false,
          "maxLen": 30
        },
        {
          "key": "contact.instagram.url",
          "type": "url",
          "label": "Instagram (secțiunea contact)",
          "required": false
        },
        {
          "key": "contact.instagram.label",
          "type": "text",
          "label": "Text Instagram (ex: @salonul_tau)",
          "required": false,
          "maxLen": 60
        },
        {
          "key": "contact.facebook.url",
          "type": "url",
          "label": "Link Facebook (opțional)",
          "required": false
        },
        {
          "key": "contact.facebook.label",
          "type": "text",
          "label": "Textul linkului Facebook",
          "required": false,
          "maxLen": 60
        },
        {
          "key": "contact.address",
          "type": "textarea",
          "label": "Adresa fizică (câte un rând pe linie)",
          "required": false,
          "maxLen": 200
        },
        {
          "key": "contact.addressHref",
          "type": "url",
          "label": "Link Google Maps pentru adresă",
          "required": false
        }
      ]
    },
    {
      "id": "seo",
      "title": "SEO & partajare socială",
      "fields": [
        {
          "key": "seo.ogImage",
          "type": "url",
          "label": "Imagine la partajare pe rețele",
          "required": false
        }
      ]
    },
    {
      "id": "footer",
      "title": "Footer",
      "fields": [
        {
          "key": "footer.address",
          "type": "text",
          "label": "Adresa scurtă din footer",
          "required": true,
          "maxLen": 120
        },
        {
          "key": "footer.year",
          "type": "text",
          "label": "Anul pentru copyright (ex: 2026)",
          "required": true,
          "maxLen": 4
        },
        {
          "key": "footer.note",
          "type": "text",
          "label": "Notița mică din footer (ex: Frumusețe cu suflet.)",
          "required": false,
          "maxLen": 100
        }
      ]
    }
  ]
}
