{
  "templateId": "portfolio",
  "version": 1,
  "name": "Salon",
  "language": "en",
  "wizardHints": {
    "vertical": "portfolio",
    "aiStyle": "editorial, gallery-first, elegant — thin serif on headings, generous whitespace, large photography; tone of a studio/salon/artist, not an admin form"
  },
  "sections": [
    {
      "id": "business",
      "title": "Despre salon",
      "fields": [
        {
          "key": "business.name",
          "type": "text",
          "label": "Nume studio, salon sau brand",
          "required": true,
          "maxLen": 60
        },
        {
          "key": "business.tagline",
          "type": "text",
          "label": "Slogan scurt (ex. Frumusețe reală, grijă din suflet)",
          "required": true,
          "maxLen": 100
        },
        {
          "key": "business.title",
          "type": "text",
          "label": "Titlu pagină pentru browser și Google",
          "required": true,
          "maxLen": 80
        },
        {
          "key": "business.metaDescription",
          "type": "textarea",
          "label": "Descriere scurtă pentru Google (1–2 propoziții despre servicii și locație)",
          "required": true,
          "maxLen": 160
        },
        {
          "key": "business.about",
          "type": "textarea",
          "label": "Povestea salonului — secțiunea „Despre noi”",
          "required": true,
          "maxLen": 600
        },
        {
          "key": "business.lang",
          "type": "text",
          "label": "Limba site-ului",
          "required": true,
          "maxLen": 5
        }
      ]
    },
    {
      "id": "labels",
      "title": "Texte butoane și secțiuni",
      "fields": [
        {
          "key": "labels.about",
          "type": "text",
          "label": "Titlu secțiune „Despre noi”",
          "required": true,
          "maxLen": 40
        },
        {
          "key": "labels.instaTitle",
          "type": "text",
          "label": "Titlu secțiune Instagram",
          "required": true,
          "maxLen": 60
        },
        {
          "key": "labels.instaFollow",
          "type": "text",
          "label": "Text buton urmărire Instagram",
          "required": true,
          "maxLen": 20
        },
        {
          "key": "labels.scroll",
          "type": "text",
          "label": "Text indicator de derulare pe deschidere",
          "required": true,
          "maxLen": 20
        },
        {
          "key": "labels.waQr",
          "type": "text",
          "label": "Titlu modal QR WhatsApp",
          "required": true,
          "maxLen": 60
        },
        {
          "key": "labels.waOpen",
          "type": "text",
          "label": "Text link „Deschide WhatsApp Web”",
          "required": true,
          "maxLen": 60
        },
        {
          "key": "labels.servicesEyebrow",
          "type": "text",
          "label": "Etichetă mică deasupra serviciilor (ex. Meniu servicii)",
          "required": true,
          "maxLen": 40
        },
        {
          "key": "labels.scheduleEyebrow",
          "type": "text",
          "label": "Etichetă mică deasupra programului (ex. Program)",
          "required": true,
          "maxLen": 40
        },
        {
          "key": "labels.galleryEyebrow",
          "type": "text",
          "label": "Etichetă mică deasupra galeriei (ex. Lucrările noastre)",
          "required": true,
          "maxLen": 40
        },
        {
          "key": "labels.teamEyebrow",
          "type": "text",
          "label": "Etichetă mică deasupra echipei (ex. Echipa noastră)",
          "required": true,
          "maxLen": 40
        },
        {
          "key": "labels.bookingEyebrow",
          "type": "text",
          "label": "Etichetă mică deasupra contactului (ex. Programări)",
          "required": true,
          "maxLen": 40
        },
        {
          "key": "labels.waBookBtn",
          "type": "text",
          "label": "Text buton WhatsApp la contact (ex. Programează pe WhatsApp)",
          "required": true,
          "maxLen": 60
        },
        {
          "key": "labels.navGallery",
          "type": "text",
          "label": "Link navigare Galerie (ex. Galerie)",
          "required": true,
          "maxLen": 24
        },
        {
          "key": "labels.navServices",
          "type": "text",
          "label": "Link navigare Servicii (ex. Servicii)",
          "required": true,
          "maxLen": 24
        },
        {
          "key": "labels.navBooking",
          "type": "text",
          "label": "Link navigare Programări (ex. Programare)",
          "required": true,
          "maxLen": 24
        },
        {
          "key": "labels.aboutCap",
          "type": "text",
          "label": "Etichetă scurtă lângă „Despre” (ex. Salon / Studio)",
          "required": false,
          "maxLen": 24
        },
        {
          "key": "labels.whatsapp",
          "type": "text",
          "label": "Etichetă link WhatsApp (secțiune contact)",
          "required": false,
          "maxLen": 24
        },
        {
          "key": "labels.close",
          "type": "text",
          "label": "Etichetă buton Închide (accesibilitate)",
          "required": false,
          "maxLen": 24
        },
        {
          "key": "labels.lightboxPrev",
          "type": "text",
          "label": "Aria-label buton anterior lightbox",
          "required": false,
          "maxLen": 24
        },
        {
          "key": "labels.lightboxNext",
          "type": "text",
          "label": "Aria-label buton următor lightbox",
          "required": false,
          "maxLen": 24
        }
      ]
    },
    {
      "id": "theme",
      "title": "Culori",
      "fields": [
        {
          "key": "theme.primary",
          "type": "color",
          "label": "Culoare principală — accent auriu-bej (ex. #C4956A)",
          "required": true
        },
        {
          "key": "theme.primaryLight",
          "type": "color",
          "label": "Nuanță accent mai deschisă (ex. #D9B08C)",
          "required": true
        },
        {
          "key": "theme.primaryDark",
          "type": "color",
          "label": "Nuanță accent mai închisă (ex. #A07548)",
          "required": true
        },
        {
          "key": "theme.cream",
          "type": "color",
          "label": "Culoare fundal (crem nude, ex. #FAF7F4)",
          "required": true
        }
      ]
    },
    {
      "id": "hero",
      "title": "Prima impresie",
      "fields": [
        {
          "key": "logo",
          "type": "text",
          "label": "Cale logo (ex. images/logo.png) — lasă gol dacă nu ai",
          "required": false,
          "maxLen": 200
        },
        {
          "key": "showWordmark",
          "type": "text",
          "label": "Arată numele ca text pe deschidere dacă nu ai logo? (true / false)",
          "required": false
        },
        {
          "key": "hero.background",
          "type": "background",
          "label": "Fundal deschidere",
          "hint": "Alege o culoare și opțional o poză. Preview-ul live se actualizează imediat.",
          "required": true,
          "maxLen": 2000
        },
        {
          "key": "hero.ctaLabel",
          "type": "text",
          "label": "Text buton principal (ex. Programează-te)",
          "required": true,
          "maxLen": 40
        }
      ]
    },
    {
      "id": "services",
      "title": "Servicii și tarife",
      "fields": [
        {
          "key": "servicesTitle",
          "type": "text",
          "label": "Titlu meniu servicii (ex. Serviciile noastre)",
          "required": false,
          "maxLen": 60
        },
        {
          "key": "services",
          "type": "list",
          "label": "Listă servicii (icon SVG + nume + preț opțional)",
          "required": false,
          "min": 0,
          "max": 16,
          "itemShape": {
            "icon": "text",
            "label": "text",
            "price": "text"
          }
        },
        {
          "key": "pricing",
          "type": "list",
          "label": "Listă de prețuri detaliată (opțional — pe lângă lista de servicii)",
          "required": false,
          "min": 0,
          "max": 20,
          "itemShape": {
            "name": "text",
            "price": "text"
          }
        }
      ]
    },
    {
      "id": "schedule",
      "title": "Program (opțional)",
      "fields": [
        {
          "key": "schedule.title",
          "type": "text",
          "label": "Titlu secțiune program (ex. Program)",
          "required": false,
          "maxLen": 60
        },
        {
          "key": "schedule.rows",
          "type": "list",
          "label": "Rânduri program (zi + ore)",
          "required": false,
          "min": 0,
          "max": 7,
          "itemShape": {
            "day": "text",
            "hours": "text"
          }
        }
      ]
    },
    {
      "id": "gallery",
      "title": "Galerie lucrări",
      "fields": [
        {
          "key": "galleryTitle",
          "type": "text",
          "label": "Titlu galerie (ex. Portofoliu) — lasă gol ca să omiți",
          "required": false,
          "maxLen": 60
        },
        {
          "key": "categories",
          "type": "list",
          "label": "Categorii lucrări (ex. Unghii, Păr, Machiaj)",
          "required": true,
          "min": 1,
          "max": 6,
          "itemShape": {
            "title": "text",
            "blurb": "text",
            "photos": "photos"
          }
        }
      ]
    },
    {
      "id": "team",
      "title": "Echipă (opțional)",
      "fields": [
        {
          "key": "team.title",
          "type": "text",
          "label": "Titlu secțiune echipă (ex. Echipa noastră)",
          "required": false,
          "maxLen": 60
        },
        {
          "key": "team.members",
          "type": "list",
          "label": "Membri echipă",
          "required": false,
          "min": 0,
          "max": 8,
          "itemShape": {
            "name": "text",
            "role": "text",
            "bio": "text",
            "photo": "text"
          }
        }
      ]
    },
    {
      "id": "instagram",
      "title": "Instagram",
      "fields": [
        {
          "key": "instagram.handle",
          "type": "text",
          "label": "Utilizator Instagram (fără @)",
          "required": false,
          "maxLen": 60
        },
        {
          "key": "instagram.url",
          "type": "url",
          "label": "URL Instagram (https://www.instagram.com/...)",
          "required": false
        },
        {
          "key": "instagram.embedUrl",
          "type": "url",
          "label": "URL feed Instafidget (opțional)",
          "required": false
        },
        {
          "key": "instagram.gallery",
          "type": "photos",
          "label": "Poze grilă Instagram (rezultate / fallback)",
          "required": false
        }
      ]
    },
    {
      "id": "contact",
      "title": "Contact și programări",
      "fields": [
        {
          "key": "contact.title",
          "type": "text",
          "label": "Titlu secțiune contact (ex. Programează o întâlnire)",
          "required": true,
          "maxLen": 50
        },
        {
          "key": "contact.intro",
          "type": "textarea",
          "label": "Text intro contact / programări",
          "required": true,
          "maxLen": 200
        },
        {
          "key": "contact.whatsapp",
          "type": "phone",
          "label": "Număr WhatsApp internațional fără + (ex. 40721234567)",
          "required": false
        },
        {
          "key": "contact.waMessage",
          "type": "textarea",
          "label": "Mesaj precompletat WhatsApp (text simplu; diacritice OK)",
          "required": false,
          "maxLen": 300
        },
        {
          "key": "contact.waHref",
          "type": "url",
          "label": "Link WhatsApp (derivat — nu edita)",
          "required": false,
          "maxLen": 500
        },
        {
          "key": "contact.phone",
          "type": "phone",
          "label": "Telefon cu prefix de țară (ex. +40 721 234 567)",
          "required": false
        },
        {
          "key": "contact.phoneDisplay",
          "type": "text",
          "label": "Telefon afișat pe site (ex. +40 721 234 567)",
          "required": false,
          "maxLen": 30
        },
        {
          "key": "contact.instagram.url",
          "type": "url",
          "label": "Instagram (secțiune contact)",
          "required": false
        },
        {
          "key": "contact.instagram.label",
          "type": "text",
          "label": "Etichetă Instagram (ex. @salonul_tau)",
          "required": false,
          "maxLen": 60
        },
        {
          "key": "contact.facebook.url",
          "type": "url",
          "label": "Link Facebook (opțional)",
          "required": false
        },
        {
          "key": "contact.facebook.label",
          "type": "text",
          "label": "Text link Facebook",
          "required": false,
          "maxLen": 60
        },
        {
          "key": "contact.address",
          "type": "textarea",
          "label": "Adresă fizică (câte un rând pe linie)",
          "required": false,
          "maxLen": 200
        },
        {
          "key": "contact.addressHref",
          "type": "url",
          "label": "Link Google Maps pentru adresă",
          "required": false
        }
      ]
    },
    {
      "id": "seo",
      "title": "Partajare pe rețele sociale",
      "fields": [
        {
          "key": "seo.ogImage",
          "type": "url",
          "label": "Imagine pentru partajare socială (recomandat 1200×630px)",
          "required": false
        }
      ]
    },
    {
      "id": "footer",
      "title": "Subsol",
      "fields": [
        {
          "key": "footer.address",
          "type": "text",
          "label": "Adresă scurtă în subsol",
          "required": true,
          "maxLen": 120
        },
        {
          "key": "footer.year",
          "type": "text",
          "label": "An copyright (ex. 2026)",
          "required": true,
          "maxLen": 4
        },
        {
          "key": "footer.note",
          "type": "text",
          "label": "Notă scurtă subsol (ex. Frumusețe cu suflet.)",
          "required": false,
          "maxLen": 100
        }
      ]
    }
  ]
}
