{
  "templateId": "evenimente",
  "version": 1,
  "name": "Evenimente & Artiști",
  "language": "ro",
  "wizardHints": {
    "vertical": "evenimente",
    "aiStyle": "editorial, rafinat, spectaculos — tonul unui fotograf sau artist de top care transformă fiecare eveniment într-o amintire de neuitat"
  },
  "sections": [
    {
      "id": "business",
      "title": "Despre afacere",
      "fields": [
        {
          "key": "business.name",
          "type": "text",
          "label": "Numele artistului / studioului / trupei",
          "required": true,
          "maxLen": 60
        },
        {
          "key": "business.tagline",
          "type": "text",
          "label": "Slogan scurt (ex: Fotograf de nuntă & portrete în Cluj)",
          "required": true,
          "maxLen": 100
        },
        {
          "key": "business.title",
          "type": "text",
          "label": "Titlul paginii (pentru browser și Google)",
          "required": true,
          "maxLen": 80
        },
        {
          "key": "business.metaDescription",
          "type": "textarea",
          "label": "Descriere SEO (1–2 propoziții despre servicii și zona de activitate)",
          "required": true,
          "maxLen": 160
        },
        {
          "key": "business.about",
          "type": "textarea",
          "label": "Textul secțiunii «Despre noi» (povestea ta, stilul, experiența)",
          "required": true,
          "maxLen": 700
        },
        {
          "key": "business.lang",
          "type": "text",
          "label": "Codul limbii paginii (ro / en)",
          "required": true,
          "maxLen": 5
        }
      ]
    },
    {
      "id": "labels",
      "title": "Etichete interfață",
      "fields": [
        {
          "key": "labels.about",
          "type": "text",
          "label": "Titlul secțiunii «Despre noi»",
          "required": true,
          "maxLen": 40
        },
        {
          "key": "labels.instaTitle",
          "type": "text",
          "label": "Titlul secțiunii Instagram",
          "required": true,
          "maxLen": 60
        },
        {
          "key": "labels.instaFollow",
          "type": "text",
          "label": "Textul butonului de follow",
          "required": true,
          "maxLen": 20
        },
        {
          "key": "labels.scroll",
          "type": "text",
          "label": "Textul indicatorului de scroll de pe hero",
          "required": true,
          "maxLen": 20
        },
        {
          "key": "labels.waQr",
          "type": "text",
          "label": "Titlul modalului QR WhatsApp",
          "required": true,
          "maxLen": 60
        },
        {
          "key": "labels.waOpen",
          "type": "text",
          "label": "Textul linkului «Deschide WhatsApp Web»",
          "required": true,
          "maxLen": 60
        },
        {
          "key": "labels.reviewsEyebrow",
          "type": "text",
          "label": "Eticheta eyebrow deasupra titlului de testimoniale (ex: Ce spun clienții)",
          "required": false,
          "maxLen": 60
        }
      ]
    },
    {
      "id": "theme",
      "title": "Culori & aspect",
      "fields": [
        {
          "key": "theme.primary",
          "type": "color",
          "label": "Culoarea de accent (implicit auriu #C9A227 — recomandăm să nu schimbi pe dark)",
          "required": true
        },
        {
          "key": "theme.primaryLight",
          "type": "color",
          "label": "Varianta deschisă a accentului",
          "required": true
        },
        {
          "key": "theme.primaryDark",
          "type": "color",
          "label": "Varianta închisă a accentului",
          "required": true
        },
        {
          "key": "theme.cream",
          "type": "color",
          "label": "Culoarea de fond (implicit #101014 — dark editorial)",
          "required": true
        }
      ]
    },
    {
      "id": "hero",
      "title": "Secțiunea hero (prima vedere)",
      "fields": [
        {
          "key": "logo",
          "type": "text",
          "label": "Calea imaginii logo (ex: images/logo.png) sau lasă gol",
          "required": false,
          "maxLen": 200
        },
        {
          "key": "showWordmark",
          "type": "text",
          "label": "Afișează numele ca text pe hero și în nav? (true / false)",
          "required": false
        },
        {
          "key": "hero.background",
          "type": "text",
          "label": "Fundalul hero — url('images/hero.jpg') sau gradient CSS dark",
          "required": true,
          "maxLen": 300
        },
        {
          "key": "hero.ctaLabel",
          "type": "text",
          "label": "Textul butonului principal de pe hero (ex: Vezi portofoliul)",
          "required": true,
          "maxLen": 40
        }
      ]
    },
    {
      "id": "services",
      "title": "Servicii oferite",
      "fields": [
        {
          "key": "servicesTitle",
          "type": "text",
          "label": "Titlul listei de servicii (ex: Ce ofer)",
          "required": false,
          "maxLen": 60
        },
        {
          "key": "services",
          "type": "list",
          "label": "Lista de servicii (SVG icon inline + denumire)",
          "required": false,
          "min": 0,
          "max": 12,
          "itemShape": {
            "icon": "text",
            "label": "text"
          }
        }
      ]
    },
    {
      "id": "packages",
      "title": "Pachete & prețuri (opțional)",
      "fields": [
        {
          "key": "packages.title",
          "type": "text",
          "label": "Titlul secțiunii de pachete (ex: Pachete disponibile)",
          "required": false,
          "maxLen": 60
        },
        {
          "key": "packages.items",
          "type": "list",
          "label": "Lista de pachete (nume, preț, descriere scurtă)",
          "required": false,
          "min": 0,
          "max": 6,
          "itemShape": {
            "name": "text",
            "price": "text",
            "desc": "text"
          }
        }
      ]
    },
    {
      "id": "video",
      "title": "Showreel video (opțional)",
      "fields": [
        {
          "key": "video.url",
          "type": "url",
          "label": "URL embed YouTube (https://www.youtube.com/embed/VIDEO_ID) sau lasă gol",
          "required": false
        },
        {
          "key": "video.label",
          "type": "text",
          "label": "Eticheta secțiunii video (ex: Showreel 2025)",
          "required": false,
          "maxLen": 60
        }
      ]
    },
    {
      "id": "gallery",
      "title": "Portofoliu foto",
      "fields": [
        {
          "key": "galleryTitle",
          "type": "text",
          "label": "Titlul secțiunii portofoliu (ex: Portofoliu) sau lasă gol",
          "required": false,
          "maxLen": 60
        },
        {
          "key": "categories",
          "type": "list",
          "label": "Categorii de portofoliu (nunți, portrete, corporate etc.)",
          "required": true,
          "min": 1,
          "max": 6,
          "itemShape": {
            "title": "text",
            "blurb": "text",
            "photos": "photos"
          }
        }
      ]
    },
    {
      "id": "reviews",
      "title": "Testimoniale (opțional)",
      "fields": [
        {
          "key": "reviews.title",
          "type": "text",
          "label": "Titlul secțiunii testimoniale (ex: Clienți fericiți)",
          "required": false,
          "maxLen": 60
        },
        {
          "key": "reviews.items",
          "type": "list",
          "label": "Lista de recenzii (text, autor, eveniment opțional)",
          "required": false,
          "min": 0,
          "max": 6,
          "itemShape": {
            "text": "textarea",
            "author": "text",
            "event": "text"
          }
        }
      ]
    },
    {
      "id": "instagram",
      "title": "Instagram",
      "fields": [
        {
          "key": "instagram.handle",
          "type": "text",
          "label": "Username Instagram (fără @)",
          "required": false,
          "maxLen": 60
        },
        {
          "key": "instagram.url",
          "type": "url",
          "label": "Link complet Instagram (https://www.instagram.com/...)",
          "required": false
        },
        {
          "key": "instagram.gallery",
          "type": "photos",
          "label": "Poze pentru grila Instagram (opțional — 6–9 imagini pătrate)",
          "required": false,
          "min": 0,
          "max": 9
        }
      ]
    },
    {
      "id": "contact",
      "title": "Contact",
      "fields": [
        {
          "key": "contact.title",
          "type": "text",
          "label": "Titlul cardului de contact (ex: Haide să lucrăm împreună)",
          "required": true,
          "maxLen": 60
        },
        {
          "key": "contact.intro",
          "type": "textarea",
          "label": "Textul introductiv al cardului de contact",
          "required": true,
          "maxLen": 200
        },
        {
          "key": "contact.whatsapp",
          "type": "phone",
          "label": "Număr WhatsApp (format internațional fără +, ex: 40721000000)",
          "required": false
        },
        {
          "key": "contact.waHref",
          "type": "url",
          "label": "Link WhatsApp cu mesaj precompletat (https://wa.me/...)",
          "required": false
        },
        {
          "key": "contact.phone",
          "type": "phone",
          "label": "Număr de telefon (cu prefix, ex: +40721000000)",
          "required": false
        },
        {
          "key": "contact.phoneDisplay",
          "type": "text",
          "label": "Numărul afișat (ex: +40 721 000 000)",
          "required": false,
          "maxLen": 30
        },
        {
          "key": "contact.instagram.url",
          "type": "url",
          "label": "Link Instagram pentru secțiunea contact",
          "required": false
        },
        {
          "key": "contact.instagram.label",
          "type": "text",
          "label": "Textul linkului Instagram (ex: @fotograf_ro)",
          "required": false,
          "maxLen": 60
        },
        {
          "key": "contact.facebook.url",
          "type": "url",
          "label": "Link Facebook (opțional)",
          "required": false
        },
        {
          "key": "contact.facebook.label",
          "type": "text",
          "label": "Textul linkului Facebook",
          "required": false,
          "maxLen": 60
        },
        {
          "key": "contact.address",
          "type": "textarea",
          "label": "Adresa sau zona de activitate (poți folosi <br> pentru rânduri noi)",
          "required": false,
          "maxLen": 200
        },
        {
          "key": "contact.addressHref",
          "type": "url",
          "label": "Link Google Maps pentru adresă",
          "required": false
        }
      ]
    },
    {
      "id": "seo",
      "title": "SEO & partajare socială",
      "fields": [
        {
          "key": "seo.ogImage",
          "type": "url",
          "label": "URL imagine pentru partajare pe social media (og:image) — recomandăm o fotografie reprezentativă 1200×630",
          "required": false
        },
        {
          "key": "seo.jsonLd",
          "type": "textarea",
          "label": "JSON-LD Schema.org (opțional — generat automat de bot)",
          "required": false
        }
      ]
    },
    {
      "id": "footer",
      "title": "Footer",
      "fields": [
        {
          "key": "footer.address",
          "type": "text",
          "label": "Adresa / zona din footer",
          "required": true,
          "maxLen": 120
        },
        {
          "key": "footer.year",
          "type": "number",
          "label": "Anul pentru copyright (ex: 2026)",
          "required": true
        },
        {
          "key": "footer.note",
          "type": "text",
          "label": "Notița mică din footer (ex: Fiecare eveniment, o amintire.)",
          "required": false,
          "maxLen": 100
        }
      ]
    }
  ]
}
