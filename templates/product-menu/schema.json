{
  "templateId": "product-menu",
  "version": 1,
  "name": "Restaurant",
  "language": "ro",
  "wizardHints": {
    "vertical": "product-menu",
    "aiStyle": "cald, apetisant, editorial de meniu — titluri serif, fundal crem cald, accente coral; tonul unui restaurant de cartier, zero clișee corporate"
  },
  "sections": [
    {
      "id": "business",
      "title": "Despre afacerea ta",
      "fields": [
        {
          "key": "business.name",
          "type": "text",
          "label": "Numele afacerii (restaurant, cafenea, magazin)",
          "required": true,
          "maxLen": 60
        },
        {
          "key": "business.tagline",
          "type": "text",
          "label": "Slogan scurt (ex. Cine de sezon, vinuri de pivniță)",
          "required": true,
          "maxLen": 100
        },
        {
          "key": "business.title",
          "type": "text",
          "label": "Titlu pagină pentru browser și Google (include orașul)",
          "required": true,
          "maxLen": 80
        },
        {
          "key": "business.metaDescription",
          "type": "textarea",
          "label": "Descriere scurtă pentru Google (ce oferi și unde ești — 1–2 propoziții)",
          "required": true,
          "maxLen": 160
        },
        {
          "key": "business.about",
          "type": "textarea",
          "label": "Povestea restaurantului (secțiunea „Despre noi”) — scurtă și personală",
          "required": true,
          "maxLen": 700
        },
        {
          "key": "business.lang",
          "type": "select",
          "label": "Limba site-ului",
          "required": true,
          "options": [
            { "value": "ro", "label": "Română" }
          ]
        }
      ]
    },
    {
      "id": "labels",
      "title": "Texte butoane și secțiuni",
      "fields": [
        {
          "key": "labels.about",
          "type": "text",
          "label": "Titlu secțiune „Despre noi” (ex. Povestea noastră)",
          "required": true,
          "maxLen": 40
        },
        {
          "key": "labels.instaTitle",
          "type": "text",
          "label": "Titlu secțiune Instagram (ex. Din bucătărie)",
          "required": true,
          "maxLen": 60
        },
        {
          "key": "labels.instaFollow",
          "type": "text",
          "label": "Text buton urmărire Instagram",
          "required": true,
          "maxLen": 20
        },
        {
          "key": "labels.scroll",
          "type": "text",
          "label": "Text indicator de derulare pe deschidere (ex. Explorează)",
          "required": true,
          "maxLen": 20
        },
        {
          "key": "labels.waQr",
          "type": "text",
          "label": "Titlu modal QR WhatsApp (ex. Deschide WhatsApp pe telefon)",
          "required": true,
          "maxLen": 60
        },
        {
          "key": "labels.waOpen",
          "type": "text",
          "label": "Text link „Deschide WhatsApp Web” din modal",
          "required": true,
          "maxLen": 60
        },
        {
          "key": "labels.whatsapp",
          "type": "text",
          "label": "Etichetă link WhatsApp (secțiune contact)",
          "required": false,
          "maxLen": 24
        },
        {
          "key": "labels.close",
          "type": "text",
          "label": "Etichetă buton Închide (accesibilitate)",
          "required": false,
          "maxLen": 24
        },
        {
          "key": "labels.menuLang",
          "type": "text",
          "label": "Etichetă alegere limbă meniu (accesibilitate)",
          "required": true,
          "maxLen": 40
        },
        {
          "key": "labels.lightboxPrev",
          "type": "text",
          "label": "Aria-label buton anterior lightbox",
          "required": false,
          "maxLen": 24
        },
        {
          "key": "labels.lightboxNext",
          "type": "text",
          "label": "Aria-label buton următor lightbox",
          "required": false,
          "maxLen": 24
        }
      ]
    },
    {
      "id": "theme",
      "title": "Culori și aspect",
      "fields": [
        {
          "key": "theme.primary",
          "type": "color",
          "label": "Culoare accent brand (ex. #B85C5C coral restaurant)",
          "required": true
        },
        {
          "key": "theme.primaryLight",
          "type": "color",
          "label": "Variantă mai deschisă a accentului",
          "required": true
        },
        {
          "key": "theme.primaryDark",
          "type": "color",
          "label": "Culoare contrast (cărbune cald, ex. #4A2C2A)",
          "required": true
        },
        {
          "key": "theme.cream",
          "type": "color",
          "label": "Culoare fundal pagină (crem cald, ex. #FAF6F1)",
          "required": true
        }
      ]
    },
    {
      "id": "hero",
      "title": "Prima impresie",
      "fields": [
        {
          "key": "logo",
          "type": "text",
          "label": "Cale logo (ex. images/logo.png) — lasă gol dacă nu ai",
          "required": false,
          "maxLen": 200
        },
        {
          "key": "showWordmark",
          "type": "text",
          "label": "Arată numele ca text elegant pe deschidere când nu există logo? (true / false)",
          "required": false
        },
        {
          "key": "hero.background",
          "type": "background",
          "label": "Fundal deschidere",
          "hint": "Alege o culoare și opțional o poză. Previzualizarea live se actualizează imediat.",
          "required": true,
          "maxLen": 2000
        },
        {
          "key": "hero.ctaLabel",
          "type": "text",
          "label": "Text buton principal (ex. Rezervă o masă)",
          "required": true,
          "maxLen": 40
        }
      ]
    },
    {
      "id": "services",
      "title": "Specialități / Produse",
      "fields": [
        {
          "key": "servicesTitle",
          "type": "text",
          "label": "Titlu listă specialități (ex. Meniu de sezon)",
          "required": false,
          "maxLen": 60
        },
        {
          "key": "services",
          "type": "list",
          "label": "Listă produse / specialități (icon opțional, label obligatoriu)",
          "required": false,
          "min": 0,
          "max": 12,
          "itemShape": {
            "icon": "text",
            "label": "text"
          }
        }
      ]
    },
    {
      "id": "menu",
      "title": "Meniu restaurant",
      "fields": [
        {
          "key": "menu.title",
          "type": "text",
          "label": "Titlu bloc meniu (ex. Meniu)",
          "required": false,
          "maxLen": 40
        },
        {
          "key": "menu.en",
          "type": "list",
          "label": "Secțiuni meniu în engleză — fiecare cu categorie + feluri",
          "required": false,
          "min": 0,
          "max": 20,
          "itemShape": {
            "category": "text",
            "items": "list"
          }
        },
        {
          "key": "menu.ro",
          "type": "list",
          "label": "Secțiuni meniu în română — fiecare cu categorie + feluri",
          "required": false,
          "min": 0,
          "max": 20,
          "itemShape": {
            "category": "text",
            "items": "list"
          }
        }
      ]
    },
    {
      "id": "gallery",
      "title": "Galerie foto",
      "fields": [
        {
          "key": "galleryTitle",
          "type": "text",
          "label": "Titlu galerie (ex. În farfurie) — lasă gol ca să omiți",
          "required": false,
          "maxLen": 60
        },
        {
          "key": "categories",
          "type": "list",
          "label": "Categorii foto (titlu + scurtă descriere + set de imagini)",
          "required": true,
          "min": 1,
          "max": 6,
          "itemShape": {
            "title": "text",
            "blurb": "text",
            "photos": "photos"
          }
        }
      ]
    },
    {
      "id": "instagram",
      "title": "Instagram",
      "fields": [
        {
          "key": "instagram.handle",
          "type": "text",
          "label": "Utilizator Instagram (fără @)",
          "required": false,
          "maxLen": 60
        },
        {
          "key": "instagram.url",
          "type": "url",
          "label": "URL Instagram (https://www.instagram.com/...)",
          "required": false
        },
        {
          "key": "instagram.embedUrl",
          "type": "url",
          "label": "URL feed Instafidget (opțional)",
          "required": false
        },
        {
          "key": "instagram.gallery",
          "type": "photos",
          "label": "Poze grilă Instagram (fallback / companion)",
          "required": false
        }
      ]
    },
    {
      "id": "contact",
      "title": "Contact și rezervări",
      "fields": [
        {
          "key": "contact.title",
          "type": "text",
          "label": "Titlu card contact (ex. Rezervă o masă)",
          "required": true,
          "maxLen": 50
        },
        {
          "key": "contact.intro",
          "type": "textarea",
          "label": "Text intro card contact (max 200 caractere)",
          "required": true,
          "maxLen": 200
        },
        {
          "key": "contact.whatsapp",
          "type": "phone",
          "label": "Număr WhatsApp internațional fără + (ex. 40721234567)",
          "required": false
        },
        {
          "key": "contact.waMessage",
          "type": "textarea",
          "label": "Mesaj precompletat WhatsApp (text simplu; diacritice OK)",
          "required": false,
          "maxLen": 300
        },
        {
          "key": "contact.waHref",
          "type": "url",
          "label": "Link WhatsApp (derivat — nu edita)",
          "required": false,
          "maxLen": 500
        },
        {
          "key": "contact.phone",
          "type": "phone",
          "label": "Telefon cu prefix de țară (ex. +40 721 234 567)",
          "required": false
        },
        {
          "key": "contact.phoneDisplay",
          "type": "text",
          "label": "Număr afișat pe site (ex. +40 721 234 567)",
          "required": false,
          "maxLen": 30
        },
        {
          "key": "contact.instagram.url",
          "type": "url",
          "label": "Instagram (secțiune contact)",
          "required": false
        },
        {
          "key": "contact.instagram.label",
          "type": "text",
          "label": "Etichetă Instagram (ex. @restaurantul_tau)",
          "required": false,
          "maxLen": 60
        },
        {
          "key": "contact.facebook.url",
          "type": "url",
          "label": "Link Facebook (opțional)",
          "required": false
        },
        {
          "key": "contact.facebook.label",
          "type": "text",
          "label": "Text link Facebook (ex. Restaurantul nostru)",
          "required": false,
          "maxLen": 60
        },
        {
          "key": "contact.address",
          "type": "textarea",
          "label": "Adresă fizică afișată (câte un rând pe linie)",
          "required": false,
          "maxLen": 200
        },
        {
          "key": "contact.addressHref",
          "type": "url",
          "label": "Link Google Maps pentru adresă",
          "required": false
        }
      ]
    },
    {
      "id": "seo",
      "title": "Partajare pe rețele sociale",
      "fields": [
        {
          "key": "seo.ogImage",
          "type": "url",
          "label": "Imagine pentru partajare socială (recomandat 1200×630px)",
          "required": false
        }
      ]
    },
    {
      "id": "footer",
      "title": "Subsol",
      "fields": [
        {
          "key": "footer.address",
          "type": "text",
          "label": "Adresă scurtă în subsol (o singură linie)",
          "required": true,
          "maxLen": 120
        },
        {
          "key": "footer.year",
          "type": "text",
          "label": "An copyright (ex. 2026)",
          "required": true,
          "maxLen": 4
        },
        {
          "key": "footer.note",
          "type": "text",
          "label": "Notă caldă în subsol (ex. Poftă bună.)",
          "required": false,
          "maxLen": 100
        }
      ]
    }
  ]
}
