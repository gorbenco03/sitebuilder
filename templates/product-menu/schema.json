{
  "templateId": "product-menu",
  "version": 1,
  "name": "Restaurant",
  "language": "en",
  "wizardHints": {
    "vertical": "product-menu",
    "aiStyle": "warm, appetizing, menu-editorial — serif titles, warm cream background, coral accents; the tone of a neighborhood restaurant or bistro, zero corporate clichés"
  },
  "sections": [
    {
      "id": "business",
      "title": "About your business",
      "fields": [
        {
          "key": "business.name",
          "type": "text",
          "label": "Business name (restaurant, café, shop)",
          "required": true,
          "maxLen": 60
        },
        {
          "key": "business.tagline",
          "type": "text",
          "label": "Short tagline (e.g., Seasonal dinners, cellar wines)",
          "required": true,
          "maxLen": 100
        },
        {
          "key": "business.title",
          "type": "text",
          "label": "Page title for the browser and Google (include your city)",
          "required": true,
          "maxLen": 80
        },
        {
          "key": "business.metaDescription",
          "type": "textarea",
          "label": "Short SEO description (what you offer and where you are — 1–2 sentences)",
          "required": true,
          "maxLen": 160
        },
        {
          "key": "business.about",
          "type": "textarea",
          "label": "Your restaurant's story (the \"About us\" section) — short and personal",
          "required": true,
          "maxLen": 700
        },
        {
          "key": "business.lang",
          "type": "text",
          "label": "Site language",
          "required": true,
          "maxLen": 5
        }
      ]
    },
    {
      "id": "labels",
      "title": "Interface labels",
      "fields": [
        {
          "key": "labels.about",
          "type": "text",
          "label": "\"About us\" section title (e.g., Our story)",
          "required": true,
          "maxLen": 40
        },
        {
          "key": "labels.instaTitle",
          "type": "text",
          "label": "Instagram section title (e.g., From the kitchen)",
          "required": true,
          "maxLen": 60
        },
        {
          "key": "labels.instaFollow",
          "type": "text",
          "label": "Instagram follow button text",
          "required": true,
          "maxLen": 20
        },
        {
          "key": "labels.scroll",
          "type": "text",
          "label": "Scroll indicator text on the hero (e.g., Explore)",
          "required": true,
          "maxLen": 20
        },
        {
          "key": "labels.waQr",
          "type": "text",
          "label": "WhatsApp QR modal title (e.g., Open WhatsApp on your phone)",
          "required": true,
          "maxLen": 60
        },
        {
          "key": "labels.waOpen",
          "type": "text",
          "label": "\"Open WhatsApp Web\" link text in the modal",
          "required": true,
          "maxLen": 60
        },
        {
          "key": "labels.whatsapp",
          "type": "text",
          "label": "WhatsApp link label (contact section)",
          "required": false,
          "maxLen": 24
        },
        {
          "key": "labels.close",
          "type": "text",
          "label": "Close button label (accessibility)",
          "required": false,
          "maxLen": 24
        }
      ]
    },
    {
      "id": "theme",
      "title": "Colors & look",
      "fields": [
        {
          "key": "theme.primary",
          "type": "color",
          "label": "Brand accent color (e.g., #B85C5C restaurant coral)",
          "required": true
        },
        {
          "key": "theme.primaryLight",
          "type": "color",
          "label": "Lighter variant of the accent color",
          "required": true
        },
        {
          "key": "theme.primaryDark",
          "type": "color",
          "label": "Contrast color (warm charcoal, e.g., #4A2C2A)",
          "required": true
        },
        {
          "key": "theme.cream",
          "type": "color",
          "label": "Page background color (warm cream, e.g., #FAF6F1)",
          "required": true
        }
      ]
    },
    {
      "id": "hero",
      "title": "Hero section (first impression)",
      "fields": [
        {
          "key": "logo",
          "type": "text",
          "label": "Logo image path (e.g., images/logo.png) — leave blank if you don't have one",
          "required": false,
          "maxLen": 200
        },
        {
          "key": "showWordmark",
          "type": "text",
          "label": "Show your name as elegant text on the hero when there's no logo? (true / false)",
          "required": false
        },
        {
          "key": "hero.background",
          "type": "background",
          "label": "Hero background",
          "hint": "Pick a color and optional photo. The live preview updates immediately.",
          "required": true,
          "maxLen": 2000
        },
        {
          "key": "hero.ctaLabel",
          "type": "text",
          "label": "Primary button text (e.g., Book a table)",
          "required": true,
          "maxLen": 40
        }
      ]
    },
    {
      "id": "services",
      "title": "Specialties / Products",
      "fields": [
        {
          "key": "servicesTitle",
          "type": "text",
          "label": "Specialties list title (e.g., Seasonal menu)",
          "required": false,
          "maxLen": 60
        },
        {
          "key": "services",
          "type": "list",
          "label": "List of products / specialties (icon field optional, label field required)",
          "required": false,
          "min": 0,
          "max": 12,
          "itemShape": {
            "icon": "text",
            "label": "text"
          }
        }
      ]
    },
    {
      "id": "menu",
      "title": "Restaurant menu",
      "fields": [
        {
          "key": "menu.title",
          "type": "text",
          "label": "Menu block title (e.g., Menu)",
          "required": false,
          "maxLen": 40
        },
        {
          "key": "menu.en",
          "type": "list",
          "label": "Menu sections (EN) — each with a category + items",
          "required": false,
          "min": 0,
          "max": 20,
          "itemShape": {
            "category": "text",
            "items": "list"
          }
        },
        {
          "key": "menu.ro",
          "type": "list",
          "label": "Menu sections (secondary language) — each with a category + items",
          "required": false,
          "min": 0,
          "max": 20,
          "itemShape": {
            "category": "text",
            "items": "list"
          }
        }
      ]
    },
    {
      "id": "gallery",
      "title": "Photo gallery",
      "fields": [
        {
          "key": "galleryTitle",
          "type": "text",
          "label": "Gallery section title (e.g., On the plate) — leave blank to omit",
          "required": false,
          "maxLen": 60
        },
        {
          "key": "categories",
          "type": "list",
          "label": "Photo categories (title + short description + set of images)",
          "required": true,
          "min": 1,
          "max": 6,
          "itemShape": {
            "title": "text",
            "blurb": "text",
            "photos": "photos"
          }
        }
      ]
    },
    {
      "id": "instagram",
      "title": "Instagram",
      "fields": [
        {
          "key": "instagram.handle",
          "type": "text",
          "label": "Instagram username (without @)",
          "required": false,
          "maxLen": 60
        },
        {
          "key": "instagram.url",
          "type": "url",
          "label": "Instagram URL (https://www.instagram.com/...)",
          "required": false
        },
        {
          "key": "instagram.embedUrl",
          "type": "url",
          "label": "Instagram feed link (optional)",
          "required": false
        },
        {
          "key": "instagram.gallery",
          "type": "photos",
          "label": "Instagram grid photos (fallback / companion)",
          "required": false
        }
      ]
    },
    {
      "id": "contact",
      "title": "Contact & reservations",
      "fields": [
        {
          "key": "contact.title",
          "type": "text",
          "label": "Contact card title (e.g., Book a table)",
          "required": true,
          "maxLen": 50
        },
        {
          "key": "contact.intro",
          "type": "textarea",
          "label": "Contact card intro text (200 characters max)",
          "required": true,
          "maxLen": 200
        },
        {
          "key": "contact.whatsapp",
          "type": "phone",
          "label": "International WhatsApp number without + (e.g., 12125550100)",
          "required": false
        },
        {
          "key": "contact.waMessage",
          "type": "textarea",
          "label": "WhatsApp prefilled message (plain text; diacritics OK)",
          "required": false,
          "maxLen": 300
        },
        {
          "key": "contact.waHref",
          "type": "url",
          "label": "WhatsApp link (derived — do not edit)",
          "required": false,
          "maxLen": 500
        },
        {
          "key": "contact.phone",
          "type": "phone",
          "label": "Phone number with country code (e.g., +12125550100)",
          "required": false
        },
        {
          "key": "contact.phoneDisplay",
          "type": "text",
          "label": "Number as displayed on the site (e.g., +1 212 555 0100)",
          "required": false,
          "maxLen": 30
        },
        {
          "key": "contact.instagram.url",
          "type": "url",
          "label": "Instagram (contact section)",
          "required": false
        },
        {
          "key": "contact.instagram.label",
          "type": "text",
          "label": "Instagram label (e.g., @your_restaurant)",
          "required": false,
          "maxLen": 60
        },
        {
          "key": "contact.facebook.url",
          "type": "url",
          "label": "Facebook link (optional)",
          "required": false
        },
        {
          "key": "contact.facebook.label",
          "type": "text",
          "label": "Facebook link text (e.g., Our Restaurant)",
          "required": false,
          "maxLen": 60
        },
        {
          "key": "contact.address",
          "type": "textarea",
          "label": "Physical address as displayed (one line per row)",
          "required": false,
          "maxLen": 200
        },
        {
          "key": "contact.addressHref",
          "type": "url",
          "label": "Google Maps link for the address",
          "required": false
        }
      ]
    },
    {
      "id": "seo",
      "title": "SEO & social sharing",
      "fields": [
        {
          "key": "seo.ogImage",
          "type": "url",
          "label": "Image for social sharing (1200×630px recommended)",
          "required": false
        }
      ]
    },
    {
      "id": "footer",
      "title": "Footer",
      "fields": [
        {
          "key": "footer.address",
          "type": "text",
          "label": "Short address in the footer (single line)",
          "required": true,
          "maxLen": 120
        },
        {
          "key": "footer.year",
          "type": "text",
          "label": "Copyright year (e.g., 2026)",
          "required": true,
          "maxLen": 4
        },
        {
          "key": "footer.note",
          "type": "text",
          "label": "Warm footer note (e.g., Enjoy your meal.)",
          "required": false,
          "maxLen": 100
        }
      ]
    }
  ]
}
