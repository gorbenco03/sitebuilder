{
  "templateId": "product-menu",
  "version": 1,
  "name": "Restaurant",
  "language": "ro",
  "wizardHints": {
    "vertical": "product-menu",
    "aiStyle": "cald, apetisant, editorial de meniu — tipografie serif pe titluri, fond crem, accente coral; ton de restaurant de cartier sau bistro, zero clișee corporate"
  },
  "sections": [
    {
      "id": "business",
      "title": "Despre afacere",
      "fields": [
        {
          "key": "business.name",
          "type": "text",
          "label": "Numele afacerii (restaurant, cafenea, magazin)",
          "required": true,
          "maxLen": 60
        },
        {
          "key": "business.tagline",
          "type": "text",
          "label": "Slogan scurt (ex: Cină de sezon, vinuri de pivniță)",
          "required": true,
          "maxLen": 100
        },
        {
          "key": "business.title",
          "type": "text",
          "label": "Titlul paginii pentru browser și Google (include orașul)",
          "required": true,
          "maxLen": 80
        },
        {
          "key": "business.metaDescription",
          "type": "textarea",
          "label": "Descriere SEO scurtă (ce oferiți și unde sunteți — 1–2 propoziții)",
          "required": true,
          "maxLen": 160
        },
        {
          "key": "business.about",
          "type": "textarea",
          "label": "Povestea restaurantului (secțiunea «Despre noi») — scurt, personal",
          "required": true,
          "maxLen": 700
        },
        {
          "key": "business.lang",
          "type": "text",
          "label": "Codul limbii paginii (ro / en)",
          "required": true,
          "maxLen": 5
        }
      ]
    },
    {
      "id": "labels",
      "title": "Etichete interfață",
      "fields": [
        {
          "key": "labels.about",
          "type": "text",
          "label": "Titlul secțiunii «Despre noi» (ex: Povestea noastră)",
          "required": true,
          "maxLen": 40
        },
        {
          "key": "labels.instaTitle",
          "type": "text",
          "label": "Titlul secțiunii Instagram (ex: Instagram din bucătărie)",
          "required": true,
          "maxLen": 60
        },
        {
          "key": "labels.instaFollow",
          "type": "text",
          "label": "Textul butonului de follow Instagram",
          "required": true,
          "maxLen": 20
        },
        {
          "key": "labels.scroll",
          "type": "text",
          "label": "Textul indicatorului de scroll pe hero (ex: Descoperă)",
          "required": true,
          "maxLen": 20
        },
        {
          "key": "labels.waQr",
          "type": "text",
          "label": "Titlul modalului QR WhatsApp (ex: Deschide WhatsApp pe telefon)",
          "required": true,
          "maxLen": 60
        },
        {
          "key": "labels.waOpen",
          "type": "text",
          "label": "Textul linkului «Deschide WhatsApp Web» din modal",
          "required": true,
          "maxLen": 60
        }
      ]
    },
    {
      "id": "theme",
      "title": "Culori & aspect",
      "fields": [
        {
          "key": "theme.primary",
          "type": "color",
          "label": "Culoarea de accent a brandului (ex: #B85C5C coral de restaurant)",
          "required": true
        },
        {
          "key": "theme.primaryLight",
          "type": "color",
          "label": "Varianta deschisă a culorii de accent",
          "required": true
        },
        {
          "key": "theme.primaryDark",
          "type": "color",
          "label": "Culoarea de contrast (antracit cald, ex: #4A2C2A)",
          "required": true
        },
        {
          "key": "theme.cream",
          "type": "color",
          "label": "Culoarea de fond a paginii (crem cald, ex: #FAF6F1)",
          "required": true
        }
      ]
    },
    {
      "id": "hero",
      "title": "Secțiunea hero (prima vedere)",
      "fields": [
        {
          "key": "logo",
          "type": "text",
          "label": "Calea imaginii logo (ex: images/logo.png) — lasă gol dacă nu ai logo",
          "required": false,
          "maxLen": 200
        },
        {
          "key": "showWordmark",
          "type": "text",
          "label": "Afișează numele ca text elegant pe hero când nu există logo? (true / false)",
          "required": false
        },
        {
          "key": "hero.background",
          "type": "text",
          "label": "Fundalul heroului — url('images/hero.jpg') sau gradient CSS cu imagine: linear-gradient(...), url('...')",
          "required": true,
          "maxLen": 300
        },
        {
          "key": "hero.ctaLabel",
          "type": "text",
          "label": "Textul butonului principal (ex: Rezervă o masă)",
          "required": true,
          "maxLen": 40
        }
      ]
    },
    {
      "id": "services",
      "title": "Specialități / Produse",
      "fields": [
        {
          "key": "servicesTitle",
          "type": "text",
          "label": "Titlul listei de specialități (ex: Meniu de sezon)",
          "required": false,
          "maxLen": 60
        },
        {
          "key": "services",
          "type": "list",
          "label": "Lista de produse / specialități (câmp icon opțional, câmp label obligatoriu)",
          "required": false,
          "min": 0,
          "max": 12,
          "itemShape": {
            "icon": "text",
            "label": "text"
          }
        }
      ]
    },
    {
      "id": "menu",
      "title": "Meniu restaurant",
      "fields": [
        {
          "key": "menu.title",
          "type": "text",
          "label": "Titlul blocului de meniu (ex: Meniu)",
          "required": false,
          "maxLen": 40
        },
        {
          "key": "menu.en",
          "type": "list",
          "label": "Secțiuni meniu (EN) — fiecare cu categorie + articole",
          "required": false,
          "min": 0,
          "max": 20,
          "itemShape": {
            "category": "text",
            "items": "list"
          }
        },
        {
          "key": "menu.ro",
          "type": "list",
          "label": "Secțiuni meniu (RO) — fiecare cu categorie + articole",
          "required": false,
          "min": 0,
          "max": 20,
          "itemShape": {
            "category": "text",
            "items": "list"
          }
        }
      ]
    },
    {
      "id": "gallery",
      "title": "Galerie foto",
      "fields": [
        {
          "key": "galleryTitle",
          "type": "text",
          "label": "Titlul secțiunii galerie (ex: Din farfurie) — lasă gol pentru a omite",
          "required": false,
          "maxLen": 60
        },
        {
          "key": "categories",
          "type": "list",
          "label": "Categorii de poze (titlu + descriere scurtă + set de imagini)",
          "required": true,
          "min": 1,
          "max": 6,
          "itemShape": {
            "title": "text",
            "blurb": "text",
            "photos": "photos"
          }
        }
      ]
    },
    {
      "id": "instagram",
      "title": "Instagram",
      "fields": [
        {
          "key": "instagram.handle",
          "type": "text",
          "label": "Username Instagram (fără @)",
          "required": false,
          "maxLen": 60
        },
        {
          "key": "instagram.url",
          "type": "url",
          "label": "Link complet Instagram (https://www.instagram.com/...)",
          "required": false
        },
        {
          "key": "instagram.embedUrl",
          "type": "url",
          "label": "URL embed Instagram (opțional)",
          "required": false
        },
        {
          "key": "instagram.gallery",
          "type": "photos",
          "label": "Poze grilă Instagram (fallback / companion) — optional",
          "required": false
        }
      ]
    },
    {
      "id": "contact",
      "title": "Contact & rezervări",
      "fields": [
        {
          "key": "contact.title",
          "type": "text",
          "label": "Titlul cardului de contact (ex: Rezervă masa)",
          "required": true,
          "maxLen": 50
        },
        {
          "key": "contact.intro",
          "type": "textarea",
          "label": "Textul introductiv al cardului de contact (maxim 200 caractere)",
          "required": true,
          "maxLen": 200
        },
        {
          "key": "contact.whatsapp",
          "type": "phone",
          "label": "Număr WhatsApp internațional fără + (ex: 40722000000)",
          "required": false
        },
        {
          "key": "contact.waHref",
          "type": "url",
          "label": "Link WhatsApp complet cu mesaj precompletat (https://wa.me/...)",
          "required": false
        },
        {
          "key": "contact.phone",
          "type": "phone",
          "label": "Număr de telefon cu prefix țară (ex: +40722000000)",
          "required": false
        },
        {
          "key": "contact.phoneDisplay",
          "type": "text",
          "label": "Numărul afișat pe site (ex: +40 722 000 000)",
          "required": false,
          "maxLen": 30
        },
        {
          "key": "contact.instagram.url",
          "type": "url",
          "label": "Link Instagram pentru secțiunea contact",
          "required": false
        },
        {
          "key": "contact.instagram.label",
          "type": "text",
          "label": "Textul linkului Instagram în contact (ex: @restaurantul_tau)",
          "required": false,
          "maxLen": 60
        },
        {
          "key": "contact.facebook.url",
          "type": "url",
          "label": "Link Facebook (opțional)",
          "required": false
        },
        {
          "key": "contact.facebook.label",
          "type": "text",
          "label": "Textul linkului Facebook (ex: Restaurantul Nostru)",
          "required": false,
          "maxLen": 60
        },
        {
          "key": "contact.address",
          "type": "textarea",
          "label": "Adresa fizică afișată (poți folosi <br> pentru rând nou)",
          "required": false,
          "maxLen": 200
        },
        {
          "key": "contact.addressHref",
          "type": "url",
          "label": "Link Google Maps pentru adresă",
          "required": false
        }
      ]
    },
    {
      "id": "seo",
      "title": "SEO & partajare socială",
      "fields": [
        {
          "key": "seo.ogImage",
          "type": "url",
          "label": "URL imagine pentru partajare socială (og:image) — recomandat 1200×630px",
          "required": false
        },
        {
          "key": "seo.jsonLd",
          "type": "textarea",
          "label": "JSON-LD Schema.org (tip Restaurant — generat automat de bot)",
          "required": false
        }
      ]
    },
    {
      "id": "footer",
      "title": "Footer",
      "fields": [
        {
          "key": "footer.address",
          "type": "text",
          "label": "Adresa scurtă în footer (o singură linie)",
          "required": true,
          "maxLen": 120
        },
        {
          "key": "footer.year",
          "type": "text",
          "label": "Anul pentru copyright (ex: 2026)",
          "required": true,
          "maxLen": 4
        },
        {
          "key": "footer.note",
          "type": "text",
          "label": "Notița caldă din footer (ex: Poftă bună la masa noastră.)",
          "required": false,
          "maxLen": 100
        }
      ]
    }
  ]
}
